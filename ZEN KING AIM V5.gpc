function FPSULTIMATE_0159() {
	for(zk_y = 3; zk_y < 46; zk_y++) {
		for(zk_x = 0; zk_x < 72; zk_x++) {
			zk_byte = zk_crown[zk_y * 9 + (zk_x >> 3)];
			zk_bit = (zk_byte >> (zk_x & 7)) & 1;
			if(!zk_bit) {
				pixel_oled(28 + zk_x, zk_y - 3, OLED_WHITE);
			}
		}
	}
	putc_oled(1, ASCII_UPPER_Z);
	putc_oled(2, ASCII_UPPER_E);
	putc_oled(3, ASCII_UPPER_N);
	putc_oled(4, ASCII_SPACE);
	putc_oled(5, ASCII_UPPER_K);
	putc_oled(6, ASCII_UPPER_I);
	putc_oled(7, ASCII_UPPER_N);
	putc_oled(8, ASCII_UPPER_G);
	putc_oled(9, ASCII_SPACE);
	putc_oled(10, ASCII_UPPER_V);
	putc_oled(11, 0x35);
	puts_oled(28, 0x34, OLED_FONT_SMALL, 11, OLED_WHITE);
}
