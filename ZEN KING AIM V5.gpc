		FPSULTIMATE_0166(TRUE);
	} else if(event_press(XB1_VIEW)) {
		FPSULTIMATE_0412[FPSULTIMATE_0330 + FPSULTIMATE_0414[FPSULTIMATE_0374]] = FPSULTIMATE_0410[FPSULTIMATE_0303 + FPSULTIMATE_0414[FPSULTIMATE_0374]];
