function FPSULTIMATE_0154() {
	if(FPSULTIMATE_0414[FPSULTIMATE_0368]) {
		if(event_press(XB1_MENU)) {
			FPSULTIMATE_0414[FPSULTIMATE_0374] = FPSULTIMATE_0414[FPSULTIMATE_0373]; 
			FPSULTIMATE_053(FPSULTIMATE_0381); 
			return;
		}
		if(event_press(XB1_VIEW) && FPSULTIMATE_0414[FPSULTIMATE_0373] == FPSULTIMATE_0387) {
			FPSULTIMATE_053(FPSULTIMATE_0382);
			return;
		}
		if(FPSULTIMATE_0414[FPSULTIMATE_0373] != FPSULTIMATE_0387) {
			if(get_ival(XB1_VIEW) && get_ptime(XB1_VIEW) >= 0x3E8) {
				FPSULTIMATE_0410[FPSULTIMATE_0299] = 0x0; 
				FPSULTIMATE_053(FPSULTIMATE_0384);
				FPSULTIMATE_0414[FPSULTIMATE_0374] = FPSULTIMATE_0414[FPSULTIMATE_0373]; 
				return;
			}
			if(event_release(XB1_VIEW)) {
				FPSULTIMATE_053(FPSULTIMATE_0383);
				FPSULTIMATE_0414[FPSULTIMATE_0374] = FPSULTIMATE_0414[FPSULTIMATE_0373]; 
				return;
			}
		}
		if(event_press(XB1_RIGHT)) {
			FPSULTIMATE_050(FPSULTIMATE_0121(FPSULTIMATE_0414[FPSULTIMATE_0373] == FPSULTIMATE_0387, FPSULTIMATE_0385, FPSULTIMATE_0387));
			return;
		}
		if(FPSULTIMATE_0414[FPSULTIMATE_0373] != FPSULTIMATE_0387) {
			if(get_ival(XB1_UP) && event_press(XB1_X) && (get_brtime(XB1_X) <= 0xF0)) {
				for(FPSULTIMATE_086 = 0x0; FPSULTIMATE_086 < 0x2; FPSULTIMATE_086++) {
					FPSULTIMATE_0416[FPSULTIMATE_0399 + FPSULTIMATE_086] = FPSULTIMATE_0412[FPSULTIMATE_0330 + FPSULTIMATE_086];
					FPSULTIMATE_0416[FPSULTIMATE_0398 + FPSULTIMATE_086] = FPSULTIMATE_0412[FPSULTIMATE_0331 + FPSULTIMATE_086];
				}
				FPSULTIMATE_0132(FPSULTIMATE_0286);
			}
		}
	}
	FPSULTIMATE_099();
	if(!FPSULTIMATE_0414[FPSULTIMATE_0370]) {
		if(event_press(FPSULTIMATE_0408[FPSULTIMATE_0263])) {
			FPSULTIMATE_052();
		}
		FPSULTIMATE_094(FPSULTIMATE_0412[FPSULTIMATE_0321], FPSULTIMATE_0412[FPSULTIMATE_0322]);
		if(!FPSULTIMATE_097()) {
			FPSULTIMATE_090();
			FPSULTIMATE_089();
			FPSULTIMATE_098();
			FPSULTIMATE_0101();
			FPSULTIMATE_0102();
		}
	}
	deadzone(FPSULTIMATE_0408[FPSULTIMATE_0254], FPSULTIMATE_0408[FPSULTIMATE_0258], 0x64, 0x64);
}
function FPSULTIMATE_0155() {
