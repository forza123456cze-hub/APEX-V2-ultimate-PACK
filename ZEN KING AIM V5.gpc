        FPSULTIMATE_0409[FPSULTIMATE_0291] /= 0xA;
        FPSULTIMATE_0409[FPSULTIMATE_0292]++;
    } while(FPSULTIMATE_0409[FPSULTIMATE_0291]);
    for(FPSULTIMATE_086 = 0x0; FPSULTIMATE_086 < FPSULTIMATE_0409[FPSULTIMATE_0292]; FPSULTIMATE_086++) {
