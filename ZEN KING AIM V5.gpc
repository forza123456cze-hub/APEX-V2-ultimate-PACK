	} else if(event_press(XB1_Y)) {
		FPSULTIMATE_0414[FPSULTIMATE_0374] = !FPSULTIMATE_0414[FPSULTIMATE_0374];
		FPSULTIMATE_0410[FPSULTIMATE_0303 + FPSULTIMATE_0414[FPSULTIMATE_0374]] = FPSULTIMATE_0416[FPSULTIMATE_0399 + FPSULTIMATE_0414[FPSULTIMATE_0374]];
