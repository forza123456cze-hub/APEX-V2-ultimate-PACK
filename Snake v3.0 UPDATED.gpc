	for(SNAKE_0277 = 0x0; SNAKE_0277 < SNAKE_0275[SNAKE_0195]; SNAKE_0277++) {
		SNAKE_0275[SNAKE_0196 + SNAKE_0277] = (SNAKE_093 % 0xA) + 0x30;
