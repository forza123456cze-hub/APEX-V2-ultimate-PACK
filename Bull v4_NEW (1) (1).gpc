    HandGunAASpeed   = UnPackInt16ToInt8(PVALData, 1);
    PVALData = get_pvar(SPVAR_16, 1, 32767, PackInt8ToInt16(0, 0));
    ToggleTaylorAR    = UnPackInt16ToInt8(PVALData, 0);
    ToggleProgressive = UnPackInt16ToInt8(PVALData, 1);
