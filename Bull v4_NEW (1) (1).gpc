    set_pvar(SPVAR_27, PVALData);
    PVALData = PackInt8ToInt16(ActivateHoldBtnIdx[6], ActivatePressBtnIdx[6]);
    set_pvar(SPVAR_28, PVALData);
    PVALData = PackInt8ToInt16(ActivateHoldBtnIdx[7], ActivatePressBtnIdx[7]);
    set_pvar(SPVAR_29, PVALData);
    PVALData = PackInt8ToInt16(ActivatePressBtnIdx1[8], ActivatePressBtnIdx[8]);
    set_pvar(SPVAR_30, PVALData)
    set_pvar(SPVAR_31, BurstFireHold);
    set_pvar(SPVAR_32, BurstFireWait)
    set_pvar(SPVAR_33, BurstFireRelease);
    set_pvar(SPVAR_34, StrafeShotTime);
    set_pvar(SPVAR_35, StrafeActiveTime);
    set_pvar(SPVAR_36, MaxReloadTime);
    set_pvar(SPVAR_37, PingDelay);
    set_pvar(SPVAR_38, HandGunVertical);
    set_pvar(SPVAR_39, GeneralSens);
    set_pvar(SPVAR_40, AdsSens);
    set_pvar(SPVAR_41, FireSens);
    set_pvar(SPVAR_42, AdsFireSens);
    PVALData = PackInt8ToInt16(HorizontalStart, HorizontalEnd);
    set_pvar(SPVAR_43, PVALData);
    PVALData = PackInt8ToInt16(FireType[0], FireType[1]);
    set_pvar(SPVAR_44, PVALData);
    PVALData = PackInt8ToInt16(FireType[2], FireType[3]);
    set_pvar(SPVAR_45, PVALData);
