	"Select", "Triangle/Y", "Cross/A", "Circle/B", "Square/X", "Dpad Down", "Dpad UP", "Dpad Left", "Dpad Right", "Share/View", "Options/Menu", "Touch/Sync", "Accx/Share", "Accy", "PS Btn", "Xbox Btn", "Xbx PR1", "Xbx PR2", "Xbx PL1", "Xbx PL2", ""
