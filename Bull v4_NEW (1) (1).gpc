function Save()
{
    PVALData = PackInt8ToInt16(TaylorARVert, TaylorARHoriz);
    set_pvar(SPVAR_1, PVALData);
    PVALData = PackInt8ToInt16(VerticalStart, VerticalEnd);
    set_pvar(SPVAR_2, PVALData);
    PVALData = PackInt8ToInt16(VerticalTime, HorizontalTime);
    set_pvar(SPVAR_3, PVALData);
    PVALData = PackInt8ToInt16(TaylorShapes, ToggleAAType);
    set_pvar(SPVAR_4, PVALData);
    PVALData = PackInt8ToInt16(AdsSpeed, TaylorAngle);
    set_pvar(SPVAR_5, PVALData);
    PVALData = PackInt8ToInt16(TaylorRadius, TaylorPBoostStr);
    set_pvar(SPVAR_6, PVALData);
    PVALData = PackInt8ToInt16(TaylorABoostSpd, TrackingSize);
    set_pvar(SPVAR_7, PVALData);
    PVALData = PackInt8ToInt16(TrackingSpeed, AimAssistSize);
    set_pvar(SPVAR_8, PVALData);
    PVALData = PackInt8ToInt16(AimAssistTime, ADS_FIRE_Size);
    set_pvar(SPVAR_9, PVALData);
    PVALData = PackInt8ToInt16(ADS_FIRE_Wait_Value, HIPFIRE_Size);
    set_pvar(SPVAR_10, PVALData);
    PVALData = PackInt8ToInt16(HIPFIRE_Wait_Value, TrackerStrength);
    set_pvar(SPVAR_11, PVALData);
    PVALData = PackInt8ToInt16(TrackerSpeed, Resolution);
    set_pvar(SPVAR_12, PVALData);
    set_pvar(SPVAR_13, HeadShotStrength);
    set_pvar(SPVAR_14, HeadShotHoldTime);
    PVALData = PackInt8ToInt16(RateOfFire, HandGunAASpeed);
    set_pvar(SPVAR_15, PVALData);
    PVALData = PackInt8ToInt16(ToggleTaylorAR, ToggleProgressive);
    set_pvar(SPVAR_16, PVALData);
    PVALData = PackInt8ToInt16(TaylorAssist, ToggleBurstFire);
    set_pvar(SPVAR_17, PVALData);
    PVALData = PackInt8ToInt16(ToggleCancelSlide, ToggleVmSpeed);
    set_pvar(SPVAR_18, PVALData);
    PVALData = PackInt8ToInt16(Buttons, Sticks);
    set_pvar(SPVAR_19, PVALData);
    PVALData = PackUnSigned(PVALData, ToggleRapidFire      , 0, 1);
    PVALData = PackUnSigned(PVALData, Triple_Sticky 		 , 1, 1);
    PVALData = PackUnSigned(PVALData, HeadShotAssist       , 2, 1);
    PVALData = PackUnSigned(PVALData, StrafeAssist         , 3, 1);
    PVALData = PackUnSigned(PVALData, ToggleStrafeShot     , 4, 1);
    PVALData = PackUnSigned(PVALData, ToggleCancelReload   , 5, 1);
    PVALData = PackUnSigned(PVALData, ToggleCrouchShot    , 6, 1);
    PVALData = PackUnSigned(PVALData, ToggleJumpShot       , 7, 1);
    PVALData = PackUnSigned(PVALData, ToggleDropShot       , 8, 1);
    PVALData = PackUnSigned(PVALData, ToggleEnemyPing     , 9, 1);
    PVALData = PackUnSigned(PVALData, ToggleHoldBreath    , 10, 1);
    PVALData = PackUnSigned(PVALData, ToggleTaylorSens    , 11, 1);
    PVALData = PackUnSigned(PVALData, ToggleBunnyHop      , 12, 1);
    PVALData = PackUnSigned(PVALData, ToggleSniperMode    , 13, 1);
    set_pvar(SPVAR_20, PVALData);
    PVALData = PackUnSigned(PVALData, ToggleBlockRumble    , 0, 1);
    PVALData = PackUnSigned(PVALData, ShapeDirection       , 1, 1);
    PVALData = PackUnSigned(PVALData, ToggleBoostFire      , 2, 1);
    PVALData = PackUnSigned(PVALData, BoostReducerv2       , 3, 1);
    PVALData = PackUnSigned(PVALData, TaylorTracking       , 4, 1);
    PVALData = PackUnSigned(PVALData, ToggleAutoRF         , 5, 1);
    PVALData = PackUnSigned(PVALData, ToggleAutoHB        , 6, 1);
    PVALData = PackUnSigned(PVALData, RfFireType           , 7, 1);
    PVALData = PackUnSigned(PVALData, BfFireType           , 8, 1);
    PVALData = PackUnSigned(PVALData, ARFireType          , 9, 1);
    PVALData = PackUnSigned(PVALData, ToggleTracker 		, 10, 1);
    PVALData = PackUnSigned(PVALData, ToggleSteadyAim		, 11, 1);
    set_pvar(SPVAR_21, PVALData);
    PVALData = PackInt8ToInt16(ActivateHoldBtnIdx[0], ActivatePressBtnIdx[0]);
    set_pvar(SPVAR_22, PVALData);
    PVALData = PackInt8ToInt16(ActivateHoldBtnIdx[1], ActivatePressBtnIdx[1]);
