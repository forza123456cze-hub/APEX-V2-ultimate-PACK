    "Drive Mode", "Deactivated", "Disables Prim/Sec", "Rapid Fire Only", "Saved", "Test", "Controller", "Remap", "Select Buttons", "Button Remaps", "Button Remaps", "The SAW Team", "AA Type Disabled", "Version One", ""};
