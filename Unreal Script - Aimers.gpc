function displayMainMenu() {
    if (updateDisplay) {
        cls_oled(0);
        for (i = 0; i < sizeof(mainMenuOptions); i++) {
            if (i == mainMenuIndex) stringColour = OLED_BLACK;
            else stringColour = OLED_WHITE;
            print(2, i * 18, OLED_FONT_MEDIUM, stringColour, mainMenuOptions[i]);
        }
        updateDisplay = FALSE;
    }
}

function displayAimAssistMenu() {
    cls_oled(0);

    if (aimAssistMenuIndex == 0) {
        print(10, 10, OLED_FONT_SMALL, OLED_WHITE, ANTIRECOIL_TEXT[0]);
        print(10, 30, OLED_FONT_MEDIUM, OLED_WHITE, valueStrings[AntiRecoilStrength]);
    }
    if (aimAssistMenuIndex == 1) {
        print(10, 10, OLED_FONT_SMALL, OLED_WHITE, STRENGTH_TEXT[0]);
        print(10, 30, OLED_FONT_MEDIUM, OLED_WHITE, valueStrings[SStrength]);
    }
    if (aimAssistMenuIndex == 2) {
        print(10, 10, OLED_FONT_SMALL, OLED_WHITE, SPEED_TEXT[0]);
        print(10, 30, OLED_FONT_MEDIUM, OLED_WHITE, valueStrings[VMSpeedValue]);
    }

if (aimAssistMenuIndex == 3) {
    print(10, 10, OLED_FONT_SMALL, OLED_WHITE, AUTOAIM_TEXT[0]);
    if (Autoaim == 0) {
        print(10, 30, OLED_FONT_MEDIUM, OLED_WHITE, OFF_TEXT[0]);
    } else if (Autoaim == 1) {
        print(10, 30, OLED_FONT_MEDIUM, OLED_WHITE, ALWAYS_ON_TEXT[0]);
    } else if (Autoaim == 2) {
        print(10, 30, OLED_FONT_MEDIUM, OLED_WHITE, NO_ADS_TEXT[0]);
    } else {
        print(10, 30, OLED_FONT_MEDIUM, OLED_WHITE, ADS_FIRE_TEXT[0]);
    }
}
    if (aimAssistMenuIndex == 4) {
        print(10, 10, OLED_FONT_SMALL, OLED_WHITE, BLOOM_TEXT[0]);
        if (BloomReducer == 0) print(10, 30, OLED_FONT_MEDIUM, OLED_WHITE, OFF_TEXT[0]);
        else print(10, 30, OLED_FONT_MEDIUM, OLED_WHITE, ON_TEXT[0]);
    }
    if (aimAssistMenuIndex == 5) {
        print(10, 10, OLED_FONT_SMALL, OLED_WHITE, AA_FIRE_SPAM_TEXT[0]);
        if (AimAssistThree == 0) print(10, 30, OLED_FONT_MEDIUM, OLED_WHITE, OFF_TEXT[0]);
        else print(10, 30, OLED_FONT_MEDIUM, OLED_WHITE, ON_TEXT[0]);
    }

    updateDisplay = FALSE;
}

function displayMacrosMenu() {
    cls_oled(0);

    if (macrosMenuIndex == 0) {
        print(10, 10, OLED_FONT_SMALL, OLED_WHITE, BUILD_TRACKER_TEXT[0]);
        if (BuildTrackerToggle == 0) print(10, 30, OLED_FONT_MEDIUM, OLED_WHITE, OFF_TEXT[0]);
        else print(10, 30, OLED_FONT_MEDIUM, OLED_WHITE, ON_TEXT[0]);
    }

    if (macrosMenuIndex == 1) {
        print(10, 10, OLED_FONT_SMALL, OLED_WHITE, HAIR_TRIGGERS_TEXT[0]);
        if (HairTriggers == 0) print(10, 30, OLED_FONT_MEDIUM, OLED_WHITE, OFF_TEXT[0]);
        else print(10, 30, OLED_FONT_MEDIUM, OLED_WHITE, ON_TEXT[0]);
    }

    if (macrosMenuIndex == 2) {
        print(10, 10, OLED_FONT_SMALL, OLED_WHITE, PICKUP_MACRO_TEXT[0]);
        print(10, 30, OLED_FONT_MEDIUM, OLED_WHITE, PickupMacroStrings[PickupMacro]);
    }

    if (macrosMenuIndex == 3) {
        print(10, 10, OLED_FONT_SMALL, OLED_WHITE, DROPSHOT_TEXT[0]);
        print(10, 30, OLED_FONT_MEDIUM, OLED_WHITE, DropshotStrings[Dropshot]);
    }

    if (macrosMenuIndex == 4) {
        print(10, 10, OLED_FONT_SMALL, OLED_WHITE, DROPSHOT_WAIT_TEXT[0]);
        print(10, 30, OLED_FONT_MEDIUM, OLED_WHITE, valueStrings[DropshotWaitTime]);
    }

    updateDisplay = FALSE;
}

// =====================================================
// CONFIGURATION FUNCTIONS
// =====================================================

function ResetScript() {
    AntiRecoilStrength  = 0;
    SStrength           = 4;
    VMSpeedValue        = 2;
    Autoaim             = 0;
    BloomReducer        = 0;
    AimAssistThree      = 0;
    BuildTrackerToggle  = 0;
    HairTriggers        = 0;
    PickupMacro         = 0;
    Dropshot            = 0;
    DropshotWaitTime    = 25;
}

function LoadDefaults() {
    AntiRecoilStrength  = get_pvar(SPVAR_1, 0, 50, 0);
    SStrength           = get_pvar(SPVAR_2, 0, 30, 4);
    VMSpeedValue        = get_pvar(SPVAR_3, 0, 9, 2);
    Autoaim             = get_pvar(SPVAR_4, 0, 3, 0);
    BloomReducer        = get_pvar(SPVAR_5, 0, 1, 0);
    AimAssistThree      = get_pvar(SPVAR_6, 0, 1, 0);
    BuildTrackerToggle  = get_pvar(SPVAR_7, 0, 1, 0);
    HairTriggers        = get_pvar(SPVAR_8, 0, 1, 0);
    PickupMacro         = get_pvar(SPVAR_9, 0, 2, 0);
    Dropshot            = get_pvar(SPVAR_10, 0, 2, 0);
    DropshotWaitTime    = get_pvar(SPVAR_11, 0, 100, 25);
}

function SaveMods() {
    set_pvar(SPVAR_1, AntiRecoilStrength);
    set_pvar(SPVAR_2, SStrength);
    set_pvar(SPVAR_3, VMSpeedValue);
    set_pvar(SPVAR_4, Autoaim);
    set_pvar(SPVAR_5, BloomReducer);
    set_pvar(SPVAR_6, AimAssistThree);
    set_pvar(SPVAR_7, BuildTrackerToggle);
    set_pvar(SPVAR_8, HairTriggers);
    set_pvar(SPVAR_9, PickupMacro);
    set_pvar(SPVAR_10, Dropshot);
    set_pvar(SPVAR_11, DropshotWaitTime);
}

function FindDeadzone() {
    image_oled(0, 0, TRUE, TRUE, XY_DEADZONE_MAP[0]);
}
function center_x(f_chars, f_font) {
    return (OLED_WIDTH / 2) - ((f_chars * f_font) / 2);
}
function print_char(x, y, ascii_val) {
    print_char_oled(x, y, OLED_FONT_MEDIUM, OLED_WHITE, ascii_val);
