const int8  sin[] = { 0, 2, 3, 5, 7, 9, 10, 12, 14, 16, 17, 19, 21, 22, 24, 26, 28, 29, 31, 33, 34, 36, 37, 39, 41, 42, 44, 45, 47, 48, 50, 52, 53, 54, 56, 57, 59, 60, 62, 63, 64, 66, 67, 68, 69, 71, 72, 73, 74, 75, 77, 78, 79, 80, 81, 82, 83, 84, 85, 86, 87, 87, 88, 89, 90, 91, 91, 92, 93, 93, 94, 95, 95, 96, 96, 97, 97, 97, 98, 98, 98, 99, 99, 99, 99, 100, 100, 100, 100, 100, 100, 100, 100, 100, 100, 100, 99, 99, 99, 99, 98, 98, 98, 97, 97, 97, 96, 96, 95, 95, 94, 93, 93, 92, 91, 91, 90, 89, 88, 87, 87, 86, 85, 84, 83, 82, 81, 80, 79, 78, 77, 75, 74, 73, 72, 71, 69, 68, 67, 66, 64, 63, 62, 60, 59, 57, 56, 54, 53, 52, 50, 48, 47, 45, 44, 42, 41, 39, 37, 36, 34, 33, 31, 29, 28, 26, 24, 22, 21, 19, 17, 16, 14, 12, 10, 9, 7, 5, 3, 2, 0, -2, -3, -5, -7, -9, -10, -12, -14, -16, -17, -19, -21, -22, -24, -26, -28, -29, -31, -33, -34, -36, -37, -39, -41, -42, -44, -45, -47, -48, -50, -52, -53, -54, -56, -57, -59, -60, -62, -63, -64, -66, -67, -68, -69, -71, -72, -73, -74, -75, -77, -78, -79, -80, -81, -82, -83, -84, -85, -86, -87, -87, -88, -89, -90, -91, -91, -92, -93, -93, -94, -95, -95, -96, -96, -97, -97, -97, -98, -98, -98, -99, -99, -99, -99, -100, -100, -100, -100, -100, -100, -100, -100, -100, -100, -100, -99, -99, -99, -99, -98, -98, -98, -97, -97, -97, -96, -96, -95, -95, -94, -93, -93, -92, -91, -91, -90, -89, -88, -87, -87, -86, -85, -84, -83, -82, -81, -80, -79, -78, -77, -75, -74, -73, -72, -71, -69, -68, -67, -66, -64, -63, -62, -60, -59, -57, -56, -54, -53, -52, -50, -48, -47, -45, -44, -42, -41, -39, -37, -36, -34, -33, -31, -29, -28, -26, -24, -22, -21, -19, -17, -16, -14, -12, -10, -9, -7, -5, -3, -2 };

init {
 set_rgb(0, 150, 255);  

    cls_oled(0);

    
    if (get_pvar(SPVAR_64, 0, 10, 5) != 9) {
        set_pvar(SPVAR_64, 9); 
        ResetScript();
        SaveMods();          
    }

    
    LoadDefaults();        
        FindDeadzone();
}



main {
  
    vm_tctrl(-VMSpeedValue);

   if (MenuLevel > 0) {
        was_menu_enabled = TRUE;
    }

    if (was_menu_enabled && MenuLevel == 0 && !startup_screen_shown) {
        cls_oled(0);
        print(center_x(sizeof(MOTION_LABEL) - 1, OLED_FONT_MEDIUM_WIDTH), 26, OLED_FONT_MEDIUM, OLED_WHITE, MOTION_LABEL[0]);
        startup_screen_shown = TRUE;
        was_menu_enabled = FALSE;
    }

    if (!mainMenuActive && !aimAssistMenuActive && !macrosMenuActive &&  get_val(XB1_LT) && event_press(XB1_MENU)) {
        MenuLevel = 1;
        mainMenuIndex = 0;
        updateDisplay = TRUE;
        displayMainMenu();
        startup_screen_shown = FALSE; 
    }
    
    // Menu Toggle (LT + Menu button)
    if (!mainMenuActive && !aimAssistMenuActive && !macrosMenuActive && get_val(XB1_LT) && event_press(XB1_MENU)) {
        MenuLevel = 1;
        mainMenuIndex = 0;
        updateDisplay = TRUE;
        displayMainMenu();
    }


    
    if (MenuLevel > 0) {
        // Back/Exit Button Logic
        if (event_press(XB1_B)) {
            if (MenuLevel == 2) {
                // Return to Main Menu
                MenuLevel = 1;
                updateDisplay = TRUE;
                displayMainMenu();
            } else if (MenuLevel == 1) {
                // Exit Menu System completely
                SaveMods(); // Save when fully exiting the menu
                MenuLevel = 0;
                updateDisplay = TRUE;
                cls_oled(0);
            }
        }

 
        
        if (MenuLevel == 1) {
            // Main Menu Navigation
            if (event_press(XB1_UP)) {
                mainMenuIndex--;
                if (mainMenuIndex < 0) mainMenuIndex = 1;
                updateDisplay = TRUE;
            }
            if (event_press(XB1_DOWN)) {
                mainMenuIndex++;
                if (mainMenuIndex >= 2) mainMenuIndex = 0;
                updateDisplay = TRUE;
            }
            
            // Menu Selection
            if (event_press(XB1_A)) {
                if (mainMenuIndex == 0) {
                    // Enter Aim Assist Menu
                    MenuLevel = 2;
                    aimAssistMenuIndex = 0;
                    updateDisplay = TRUE;
                    displayAimAssistMenu();
                } else if (mainMenuIndex == 1) {
                    // Enter Macros Menu
                    MenuLevel = 2;
                    macrosMenuIndex = 0;
                    updateDisplay = TRUE;
                    displayMacrosMenu();
                }
            }

            if (updateDisplay) displayMainMenu();
        }

  
        
        if (MenuLevel == 2 && mainMenuIndex == 0) {
            // Aim Assist Submenu Navigation
            if (event_press(XB1_RIGHT)) {
                aimAssistMenuIndex++;
                if (aimAssistMenuIndex >= AIM_MENU_COUNT) aimAssistMenuIndex = 0;
                updateDisplay = TRUE;
            }
            if (event_press(XB1_LEFT)) {
                aimAssistMenuIndex--;
                if (aimAssistMenuIndex < 0) aimAssistMenuIndex = AIM_MENU_COUNT - 1;
                updateDisplay = TRUE;
            }

            
            if (aimAssistMenuIndex == 0) { 
                if (press_hold(XB1_UP)) {
                    AntiRecoilStrength = Cycle(AntiRecoilStrength++, 0, 50);
                    updateDisplay = TRUE;
                }
                if (press_hold(XB1_DOWN)) {
                    AntiRecoilStrength = Cycle(AntiRecoilStrength--, 0, 50);
                    updateDisplay = TRUE;
                }
            }
            
            if (aimAssistMenuIndex == 1) { 
                if (press_hold(XB1_UP)) {
                    SStrength = Cycle(SStrength++, 0, 30);
                    updateDisplay = TRUE;
                }
                if (press_hold(XB1_DOWN)) {
                    SStrength = Cycle(SStrength--, 0, 30);
                    updateDisplay = TRUE;
                }
            }
            
            if (aimAssistMenuIndex == 2) { 
                if (press_hold(XB1_UP)) {
                    VMSpeedValue = Cycle(VMSpeedValue++, 0, 9);
                    updateDisplay = TRUE;
                }
                if (press_hold(XB1_DOWN)) {
                    VMSpeedValue = Cycle(VMSpeedValue--, 0, 9);
                    updateDisplay = TRUE;
                }
            }
            
if (aimAssistMenuIndex == 3) {
    if (event_press(XB1_UP)) {
        if (Autoaim > 0) Autoaim--;
        else Autoaim = 3; 
        updateDisplay = TRUE;
    }

    if (event_press(XB1_DOWN)) {
        if (Autoaim < 3) Autoaim++;
        else Autoaim = 0;
        updateDisplay = TRUE;
    }
}


            
            if (aimAssistMenuIndex == 4) { 
                if (event_press(XB1_UP) || event_press(XB1_DOWN)) {
                    BloomReducer = !BloomReducer;
                    updateDisplay = TRUE;
                }
            }
            
            if (aimAssistMenuIndex == 5) { 
                if (event_press(XB1_UP) || event_press(XB1_DOWN)) {
                    AimAssistThree = !AimAssistThree;
                    updateDisplay = TRUE;
                }
            }

            if (updateDisplay) displayAimAssistMenu();
        }


        
        if (MenuLevel == 2 && mainMenuIndex == 1) {
            // Macros Submenu Navigation
            if (event_press(XB1_RIGHT)) {
                macrosMenuIndex++;
                if (macrosMenuIndex >= MACROS_MENU_COUNT) macrosMenuIndex = 0;
                updateDisplay = TRUE;
            }
            if (event_press(XB1_LEFT)) {
                macrosMenuIndex--;
                if (macrosMenuIndex < 0) macrosMenuIndex = MACROS_MENU_COUNT - 1;
                updateDisplay = TRUE;
            }

            
            if (macrosMenuIndex == 0) { 
                if (event_press(XB1_UP) || event_press(XB1_DOWN)) {
                    BuildTrackerToggle = !BuildTrackerToggle;
                    updateDisplay = TRUE;
                }
            }
            
            if (macrosMenuIndex == 1) { 
                if (event_press(XB1_UP) || event_press(XB1_DOWN)) {
                    HairTriggers = !HairTriggers;
                    updateDisplay = TRUE;
                }
            }
            
            if (macrosMenuIndex == 2) { 
                if (press_hold(XB1_UP)) {
                    PickupMacro = Cycle(PickupMacro++, 0, 2);
                    updateDisplay = TRUE;
                }
                if (press_hold(XB1_DOWN)) {
                    PickupMacro = Cycle(PickupMacro--, 0, 2);
                    updateDisplay = TRUE;
                }
            }
       if (macrosMenuIndex == 3) { 
    if (press_hold(XB1_UP)) {
        Dropshot = Cycle(Dropshot++, 0, 2);  
        updateDisplay = TRUE;
    }
    if (press_hold(XB1_DOWN)) {
        Dropshot = Cycle(Dropshot--, 0, 2);  
        updateDisplay = TRUE;
    }
}
            
            if (macrosMenuIndex == 4) { 
                if (press_hold(XB1_UP) && DropshotWaitTime < 100) {
                    DropshotWaitTime++;
                    updateDisplay = TRUE;
                }
                if (press_hold(XB1_DOWN) && DropshotWaitTime > 0) {
                    DropshotWaitTime--;
                    updateDisplay = TRUE;
                }
            }

            if (updateDisplay) displayMacrosMenu();
        }
    }


    
    // Macros Menu Navigation (This appears redundant with the code above)
    if (macrosMenuActive) {
        if (event_press(XB1_B)) {
            macrosMenuActive = FALSE;
            mainMenuActive = TRUE;
            updateDisplay = TRUE;
            displayMainMenu();
        } else {
            // Navigation and settings code (redundant)
            // ...removed for clarity as it's duplicated above...
        }
    }

    
    if (BuildTrackerToggle) {
        if (event_press(Build)) {
            BuildTrack = !BuildTrack;
        }

        if (BuildTrack) {
            BuildCount += get_rtime();

            if (event_press(Pickaxe) || BuildCount == 3000) {
                BuildTrack = FALSE;
                BuildCount = 0;
            }

            if (get_ival(Roof) || get_ival(Floor) || get_ival(Ramp) || get_ival(Wall) || get_ival(Trap)) {
                BuildCount = 0;
            }
        }
    }

   
    
    if (!BuildTrack) {
        // Anti-Recoil Feature
        if (AntiRecoilStrength > 0 && get_ival(XB1_LT) && get_ival(XB1_RT)) {
            combo_run(AntiRecoil);
        } else {
            combo_stop(AntiRecoil);
        }
        
        
        if (get_ival(XB1_LT) && event_press(XB1_RIGHT)) {
    if (Autoaim > 0) {
        AutoaimBackup = Autoaim;  
        Autoaim = 0;              
        set_rgb(255, 0, 0);       
    } else {
        Autoaim = AutoaimBackup; 
        set_rgb(0, 255, 0);      
    }
    combo_run(rumble);
}
        

        
if (Autoaim > 0) {
    set_rgb(234, 0, 255);

    if (abs(get_ival(PS4_LX)) <= 35 && abs(get_ival(PS4_LY)) <= 35 && !get_ival(XB1_X)) {
        if (
            Autoaim == 1 ||  // Always On
            (Autoaim == 2 && !get_ival(XB1_LT)) ||  // No ADS
            (Autoaim == 3 && get_ival(XB1_LT) && get_ival(XB1_RT))  // ADS + FIRE
        ) {
            combo_run(AutoTrack);
        } else {
            combo_stop(AutoTrack);
        }
    } else {
        combo_stop(AutoTrack);
    }
} else {
    combo_stop(AutoTrack);
}



        // Bloom Reducer Feature
        if (BloomReducer == 1 && get_ival(XB1_LT) && get_ival(XB1_RT)) {
       
            combo_stop(AimAssistThree);
            combo_stop(AutoTrack);

            if (abs(get_ival(PS4_LX)) <= 40 && abs(get_ival(PS4_LY)) <= 40) {
                combo_run(AntiBloom);
            } else {
                combo_stop(AntiBloom);
            }
        } else if (BloomReducer && !get_ival(XB1_LT)) {
            if (get_ival(XB1_LT) && get_ival(XB1_RT)) {
                combo_run(AntiBloom);
            }
            if (abs(get_ival(PS4_LX)) > 40 || abs(get_ival(PS4_LY)) > 40) {
                combo_stop(AntiBloom);
            }
        } else {
            combo_stop(AntiBloom);
        }

        // Aim Assist Three Feature
        if (AimAssistThree == 1 &&
            get_ival(XB1_RT) &&
            abs(get_ival(PS4_LX)) <= 70 &&
            abs(get_ival(PS4_LY)) <= 70 &&
            !get_ival(XB1_LT)) {
            combo_run(AimAssistThree);
        } else if (get_ival(XB1_LT)) {
            combo_stop(AimAssistThree);
        } else {
            combo_stop(AntiBloom);
        }

        // Stop Auto Tracking if Aim Assist Three is active and R2 is held
        if (AimAssistThree == 1 && get_ival(XB1_RT)) {
            combo_stop(AutoTrack);
        }

       
        if (PickupMacro == 1 && get_ival(XB1_RB) && get_ival(XB1_LB)) {
            combo_run(PickupMacroCombo);
        }

        if (PickupMacro == 2 && get_ival(XB1_X)) { // Interact button
            combo_run(PickupMacroCombo);
        }

  if (Dropshot == 1 && get_ival(XB1_RT) && get_ival(XB1_LT)) {
    combo_run(DropshotCombo);
}

if (Dropshot == 2 && get_ival(XB1_RT)) {  // Changed from ADS to FIRE only
    combo_run(DropshotCombo);
}
    }
  
    if (HairTriggers == 1) {
        combo_run(hair_triggers);
    }
    
   if (SStrength > 0 && !BuildTrack) {
    combo_run(BraveBooster20);
    combo_run(BraveBooster40);
    combo_run(BraveBooster60);
    combo_run(BraveBooster80);
    combo_run(BraveBooster100);
} else {
    combo_stop(BraveBooster20);
    combo_stop(BraveBooster40);
    combo_stop(BraveBooster60);
    combo_stop(BraveBooster80);
    combo_stop(BraveBooster100);
}

}



combo BraveBooster20 {
    Brave(PS4_RX, SStrength);
    Brave(PS4_RY, SStrength); 
    wait(movement_delay); 
    Brave(PS4_RX, -SStrength);
    wait(movement_delay);
    Brave(PS4_RY, -SStrength);
    wait(movement_delay);
}

combo BraveBooster40 {
    Brave(PS4_RX, SStrength);
    wait(movement_delay);
    Brave(PS4_RY, SStrength);
    Brave(PS4_RX, -SStrength);
    Brave(PS4_RY, -SStrength);
    wait(movement_delay);
}

combo BraveBooster60 {
    Brave(PS4_RX, SStrength);
    Brave(PS4_RY, SStrength);
    Brave(PS4_RX, -SStrength);
    wait(movement_delay);
    Brave(PS4_RY, -SStrength);
    wait(movement_delay);
}

combo BraveBooster80 {
    Brave(PS4_RX, SStrength); 
    wait(movement_delay);
    Brave(PS4_RY, SStrength);
    Brave(PS4_RX, -SStrength);
    wait(movement_delay);
    Brave(PS4_RY, -SStrength);
    wait(movement_delay);
}

combo BraveBooster100 {
    Brave(PS4_RX, SStrength);
    Brave(PS4_RY, SStrength);
    wait(movement_delay);
    Brave(PS4_RX, -SStrength);
    Brave(PS4_RY, -SStrength);
}

// =====================================================
// COMBO DEFINITIONS - CORE FEATURES
// =====================================================

combo AntiBloom {
    set_val(LX, -40);
    wait(50);
    set_val(LX, 40);
    wait(50);
}

combo AimAssistThree {
    set_val(LX, -100 + get_ival(LX));
    wait(15);
    set_val(LX, 100 + get_ival(LX));
    wait(15);
}

combo AutoTrack {
    set_val(LX, -AutoTrackStrength);
    wait(AutoTrackWait);  
    set_val(LX, AutoTrackStrength);
}

combo AntiRecoil {
    AntirecoilVertical = get_ival(PS4_RY) + AntiRecoilStrength;
    if (AntirecoilVertical > 100) AntirecoilVertical = 100;
    if (abs(get_val(PS4_RY)) < abs(AntiRecoilStrength) + 5)
        set_val(PS4_RY, AntirecoilVertical);
}

combo hair_triggers {
    if (get_ival(ADS)) set_val(ADS, 100);
    if (get_ival(FIRE)) set_val(FIRE, 100);
}

combo PickupMacroCombo {
    set_val(Interact, 100);
    wait(1);
    set_val(Interact, 0);
    wait(1);
}

combo DropshotCombo {
    set_val(Crouch, 100);
    wait(DropshotWaitTime);
    set_val(Crouch, 0);
    wait(DropshotWaitTime);
}

combo rumble {
    set_rumble(RUMBLE_B, 20);
    wait(150);
    reset_rumble();
}

combo b4ave { FindDeadzone(); }

combo sL {
    FindDeadzone();
}


function Initiate(int abs) {
    if (abs < 0) abs = inv(abs);
    return abs;
}

function Return(int getvalue) {
    getvalue = get_val(getvalue);
    return getvalue;
}

function iif(Expression, TrueVar, FalseVar) {
    if (Expression) return TrueVar;
    return FalseVar;
}

function Cycle(fVal, fLow, fHigh) {
    return iif(fVal > fHigh, fLow, iif(fVal < fLow, fHigh, fVal));
}

function press_hold(fButton) {
    return event_press(fButton) || (get_ival(fButton) && get_ptime(fButton) > 250 && !(get_ptime(fButton) % (get_rtime() << 3)));
}

function Set_Val(stick, value) {
    set_val(stick, clamp(value * (100 - abs(get_val(stick))) / 100 + get_val(stick), -100, 100));
}

function Brave(int stick, int value) {
    if(abs(get_val(stick)) < deadzone_threshold) {
        set_val(stick, value);
    }
}

