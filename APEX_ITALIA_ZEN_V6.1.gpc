//FUNZIONE POLAR AIM
function calculate(int v, int lo, int hi) {  
      if(v < lo) return lo;               
      if(v > hi) return hi;        
      return v;     
    }    
function xy_val(f_axis,f_val) {
    if(abs(get_val(f_axis)) < stickyaim_size[profile_idx]+ stickyaim_boost+ 1) 
        return f_val;
    return get_val(f_axis); 
}

  /*— ◌ — ◌ — ◌ — ◌ — ◌ — ◌ — ◌ — ◌ — ◌ — ◌ — ◌ — ◌ — ◌ — ◌ — ◌ — ◌ — ◌ — ◌ — ◌ — ◌ — ◌ — ◌ — ◌ — ◌ — ◌ — ◌ — ◌ — ◌ — ◌ — ◌
  |                                                       FUNCTIONS                                                       |
  ◌ — ◌ — ◌ — ◌ — ◌ — ◌ — ◌ — ◌ — ◌ — ◌ — ◌ — ◌ — ◌ — ◌ — ◌ — ◌ — ◌ — ◌ — ◌ — ◌ — ◌ — ◌ — ◌ — ◌ — ◌ — ◌ — ◌ — ◌ — ◌ — ◌ —*/	


