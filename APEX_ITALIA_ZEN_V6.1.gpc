// 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 

function value_change(f_val,f_btn,f_inc, f_rng_min, f_rng_max) { 

    if(press_hold(f_btn)) 
    {
        f_val += f_inc;
      
    // Substract    
        if(f_val < inv(f_rng_min)) 
        	f_val = inv(f_rng_min); 
   	// Add   
       	if(f_val > f_rng_max) 
        	f_val = f_rng_max;

        display_new = TRUE;
    }
    return f_val; 
} 

// 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 

function p_val() {
    p_count++;
    if(p_count == vm[p]) {
        p_count = 0;
        ar_y += inc[p];
    }
    return ar_y;
} 

// 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 

function p_cycle() { 
    vm_count++;
    if (vm_count > vm_loops) { 
        if(!p) {
            vm_count = 0;
            return 1;
        }
        else{
            vm_count = vm_loops; 
            return -1;
         } 
     }
     return p;
}        

// 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 
function per_bullet_horizontal() { 
	if(bulleth <= GUN_INFO[nomearmi[profile_idx]][1])
	{
		vm_counth++;

		if (vm_counth > (vm_loopsh * bulleth))
		{ 
			bulleth += 1;	

			if(HORIZONTAL[nomearmi[profile_idx]][bulleth - 1] < HORIZONTAL[nomearmi[profile_idx]][bulleth] )    
				inch = 1;
			if(HORIZONTAL[nomearmi[profile_idx]][bulleth - 1] > HORIZONTAL[nomearmi[profile_idx]][bulleth] )
				inch = -1;
				prh  = abs(HORIZONTAL[nomearmi[profile_idx]][bulleth - 1] - HORIZONTAL[nomearmi[profile_idx]][bulleth]); 
				vmh  = vm_loopsh / prh; 
		}	

		if(prh != 0 || HORIZONTAL[nomearmi[profile_idx]][bulleth] == 0)
		{
			p_counth++;

			if(vmh == 0)
				ar_x = HORIZONTAL[nomearmi[profile_idx]][bulleth];
			if(p_counth > vmh && vmh != 0)
			{
				p_counth = 0;

				if(inch > 0 && HORIZONTAL[nomearmi[profile_idx]][bulleth] > ar_x)	
					ar_x += inch;
				if(inch < 0 && HORIZONTAL[nomearmi[profile_idx]][bulleth] < ar_x)	
					ar_x += inch;
			}
		}
	}
	else
		ar_x = 0;
		return ar_x;
}      
function adjust_recoilx(val, s_mod) {
	 {
      if (optic[profile_idx] == 0) {
		sens = (val * s_mod)/100;
        val = (val + sens);}
     
     if (optic[profile_idx] == 1) {
		sens = (val * s_mod)/100;
        val = (val + sens);
        } 
        
	 if (optic[profile_idx] == 2) {
		sens = (val * s_mod)/100;
        val = (val + sens) ;
        } 
  
	 if (optic[profile_idx] == 3) {
		sens = (val * s_mod)/100;
        val = (val + sens);
        } 
           
	}
		return val;	
}	
function adjust_recoily(val) {
	 {
      s = (val * optic_recoil) /100; 
		
        val = val + s ;
		
	}
		return val;	
}	
function adjust_recoilyhip(val) {
	 {
      s = (val * hip_fire_sens[nomearmi[profile_idx]]) /100; 
		
        val = val + s ;
		
	}
		return val;	
}	
