			display_edit( 1, center_x(sizeof(ANTIRECOIL_MID) - 1, OLED_FONT_MEDIUM_WIDTH)        , ANTIRECOIL_MID[0]        , antirecoil_mid[nomearmi[profile_idx]]     );
			display_edit( 2 , center_x(sizeof(ANTIRECOIL_END) - 1, OLED_FONT_MEDIUM_WIDTH)        , ANTIRECOIL_END[0]        , antirecoil_end[nomearmi[profile_idx]]       );
			display_edit( 3 , center_x(sizeof(ANTIRECOIL_TIME) - 1, OLED_FONT_MEDIUM_WIDTH)       , ANTIRECOIL_TIME[0]       , antirecoil_time[nomearmi[profile_idx]]       );
			display_edit( 4 , center_x(sizeof(HIP_FIRE) - 1, OLED_FONT_MEDIUM_WIDTH)       , HIP_FIRE [0]       , hip_fire_sens[nomearmi[profile_idx]]       );
			display_edit( 5, center_x(sizeof(ANTIRECOIL_HORIZONTAL) - 1, OLED_FONT_MEDIUM_WIDTH) , ANTIRECOIL_HORIZONTAL[0] , antirecoil_horizontal[nomearmi[profile_idx]] );
			display_edit( 6 , center_x(sizeof(RATE_OF_FIRE)      - 1, OLED_FONT_MEDIUM_WIDTH)     , RATE_OF_FIRE[0]      , rate_of_fire[nomearmi[profile_idx]]    );
		    display_edit( 7 , center_x(sizeof(AMP_STRAFE)          - 1, OLED_FONT_MEDIUM_WIDTH)  , AMP_STRAFE[0]          , Amp_strafe [profile_idx]                   );
            display_edit( 8 , center_x(sizeof(VELO_STRAFE)        - 1, OLED_FONT_MEDIUM_WIDTH)   , VELO_STRAFE[0]        , Vel_strafe [profile_idx]              );
            display_edit( 9 , center_x(sizeof(POLAR_RAGGIO)      - 1,OLED_FONT_MEDIUM_WIDTH)     , POLAR_RAGGIO[0]      , RADIUS[profile_idx]                        );
            display_edit( 10 , center_x(sizeof(POLAR_STEPS)       - 1, OLED_FONT_MEDIUM_WIDTH)    , POLAR_STEPS[0]       , STEPS[profile_idx]                         );
            display_edit( 11 , center_x(sizeof(POLAR_BOOST)       - 1, OLED_FONT_MEDIUM_WIDTH)    , POLAR_BOOST[0]       , polar_boost[profile_idx]                );
            display_edit( 12 , center_x(sizeof(STICKYAIM_SIZE)    - 1, OLED_FONT_MEDIUM_WIDTH)    , STICKYAIM_SIZE[0]    , stickyaim_size [profile_idx]               );
            display_edit( 13 , center_x(sizeof(STICKYAIM_TIME)    - 1, OLED_FONT_MEDIUM_WIDTH)    , STICKYAIM_TIME[0]    , stickyaim_time [profile_idx]               );
            display_edit( 14 , center_x(sizeof(STICKYAIM_BOOST)    - 1, OLED_FONT_MEDIUM_WIDTH)   , STICKYAIM_BOOST[0]    , stickyaim_boost [profile_idx]          );
            display_edit( 15 , center_x(sizeof(TIMESWAPP)    - 1, OLED_FONT_MEDIUM_WIDTH)   , TIMESWAPP[0]    , autoshield_time   );
            display_edit( 16 , center_x(sizeof(X1)    - 1, OLED_FONT_MEDIUM_WIDTH)   , X1[0]    , x1   );
            display_edit( 17 , center_x(sizeof(X2)    - 1, OLED_FONT_MEDIUM_WIDTH)   , X2[0]    , x2   );
            display_edit( 18 , center_x(sizeof(X3)    - 1, OLED_FONT_MEDIUM_WIDTH)   , X3[0]    , x3   );
            display_edit( 19 , center_x(sizeof(X4)    - 1, OLED_FONT_MEDIUM_WIDTH)   , X4[0]    , x4   );
            
        }
		else
		{
	    // Display Mod Name and ON/OFF
    		// Mods that can have different ON/OFF status depending the active Profile
    		
		  //display_mod( corresponding modName_idx , center_x(sizeof(corresponding_string_to_display) - 1, OLED_FONT_MEDIUM_WIDTH) , corresponding_string_to_display[0] , toggle_I_want_to_be_displayed[profile]);
		    display_mod3( 0 ,  center_x(sizeof(ARMI) - 1, OLED_FONT_MEDIUM_WIDTH)    , ARMI [0]   , nomearmi[profile_idx]);
			display_mod(  1 ,  center_x(sizeof(ANTIRECOIL) - 1, OLED_FONT_MEDIUM_WIDTH) , ANTIRECOIL[0] , toggle_antirecoil[profile_idx]);
			display_mod(  2 ,  center_x(sizeof(ANTIRECOIL1) - 1, OLED_FONT_MEDIUM_WIDTH) , ANTIRECOIL1[0] , toggle_legacyar[profile_idx]);
			display_mod6( 3 , center_x(sizeof(OPTICS)   - 1, OLED_FONT_MEDIUM_WIDTH)  , OPTICS[0]  , optic[profile_idx]);
			display_mod7( 4 , center_x(sizeof(OPTICSET)   - 1, OLED_FONT_MEDIUM_WIDTH)  , OPTICSET[0]  );
			display_mod5( 5 ,  center_x(sizeof(RAPIDFIRE)   - 1, OLED_FONT_MEDIUM_WIDTH)  , RAPIDFIRE[0] , toggle_rapidfire[nomearmi[profile_idx]]);
		    display_mod1( 6 ,  center_x(sizeof(AIMABUSE) - 1, OLED_FONT_MEDIUM_WIDTH), AIMABUSE[0], aimabuse_on[profile_idx]);
		    display_mod9( 7 ,  center_x(sizeof(STRAFE)   - 1, OLED_FONT_MEDIUM_WIDTH)  , STRAFE[0]     , strafe_on[profile_idx] );
		    display_mod(  8 ,  center_x(sizeof(POLARAIM)    - 1, OLED_FONT_MEDIUM_WIDTH)  , POLARAIM[0]      , polar_aim[profile_idx] );
            display_mod(  9 ,  center_x(sizeof(STICKYAIM)   - 1, OLED_FONT_MEDIUM_WIDTH)  , STICKYAIM[0]     , sticky_aim[profile_idx]  ); 
            display_mod8( 10 ,  center_x(sizeof(TBAG)   - 1, OLED_FONT_MEDIUM_WIDTH)  , TBAG[0]     , tbag_on[profile_idx]); 
		    display_mod8( 11 ,  center_x(sizeof(JUMPSHOT)   - 1, OLED_FONT_MEDIUM_WIDTH) , JUMPSHOT[0]     ,toggle_jumpshot[profile_idx] );
            display_mod1( 12 , center_x(sizeof(CANCELSLIDE) - 1, OLED_FONT_MEDIUM_WIDTH) , CANCELSLIDE[0]    , cancel_slide[profile_idx] ); 
            display_mod1( 13 , center_x(sizeof(AUTO_PING)   - 1, OLED_FONT_MEDIUM_WIDTH)  , AUTO_PING[0]     , enemy_ping); 
		    display_mod8( 14 ,  center_x(sizeof(DOPPIOJUMP) - 1, OLED_FONT_MEDIUM_WIDTH) , DOPPIOJUMP[0] , doppiojump_on);
			display_mod1( 15 ,  center_x(sizeof(INVERTED) - 1, OLED_FONT_MEDIUM_WIDTH), INVERTED[0], inverted_on);
			display_mod2( 16 ,  center_x(sizeof(CONTROLLER) - 1, OLED_FONT_MEDIUM_WIDTH)    , CONTROLLER[0]    , Buttons);
			display_mod(  17 , center_x(sizeof(AUTOSHIELD)   - 1, OLED_FONT_MEDIUM_WIDTH)  , AUTOSHIELD[0]     , autoshield);
			display_mod10( 18 ,  center_x(sizeof(FASTTOGLE) - 1, OLED_FONT_MEDIUM_WIDTH)    , FASTTOGLE[0] , fast_toogle);
			display_mod11( 19 , center_x(sizeof(PADORMK)   - 1, OLED_FONT_MEDIUM_WIDTH)  , PADORMK[0],pad_or_MK  );
			
	} 
	
	// Display Profile only on mods that may have a different value depending on the Profile

		if(modName_idx <= AMOUNT_OF_MULTI_TOGGLE || modName_idx == 5 || modName_idx == 6 || modName_idx == 7 || modName_idx == 8 || modName_idx == 9 || modName_idx == 10 || modName_idx == 11 || modName_idx == 12)  // idx from 0 to 4 are mods that can have different values depending the active Profile
		{
			    if(profile_idx == 0)
			   // display_mod( 0 ,  center_x(sizeof(ANTIRECOIL) - 1, OLED_FONT_MEDIUM_WIDTH) , ANTIRECOIL[0] , toggle_antirecoil[profile_idx]); // profile_idx = profile_idx = Profile
    			print(center_x(sizeof(PROFILE_1) - 1,OLED_FONT_SMALL_WIDTH) ,23,OLED_FONT_SMALL,OLED_WHITE,PROFILE_1[0]); // print Profile 1
    			//line_oled(0, 26, 39, 26, 5, 1); // print a line to the left to say profile 1
    			
    	else if(profile_idx == 1)
    				print(center_x(sizeof(PROFILE_2) - 1,OLED_FONT_SMALL_WIDTH) ,23,OLED_FONT_SMALL,OLED_WHITE,PROFILE_2[0]); // print Profile 2
    				
    			//line_oled(44, 26, 83, 26, 5, 1); // print a line in the middle to say Profile 2
    	else if(profile_idx == 2)
    				print(center_x(sizeof(PROFILE_3) - 1,OLED_FONT_SMALL_WIDTH) ,23,OLED_FONT_SMALL,OLED_WHITE,PROFILE_3[0]); // print Profile 3
         }
		else if (modName_idx == 13 || modName_idx == 14 || modName_idx == 15 || modName_idx == 16 || modName_idx == 17 )// Mods that work on every profiles print the 3 lines (disable this if you prefer display the text Profile X
    	{
    	    print(center_x(sizeof(ALLPROFILES) - 1,OLED_FONT_SMALL_WIDTH) ,23,OLED_FONT_SMALL,OLED_WHITE,ALLPROFILES[0]); // print All profiles
    		//line_oled(0, 26, 39, 26, 5, 1);ANDRY85
    		//line_oled(44, 26, 83, 26, 5, 1);ANDRY85
    		//line_oled(88, 26, 127, 26, 5, 1);ANDRY85
    	}
    	
		display_black = TRUE;
        display_new = FALSE;
} // display_new end
    
// 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 〜 
led(profile_idx);
} // NOT KillSwitch end

}

