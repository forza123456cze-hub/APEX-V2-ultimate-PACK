	cls_oled(0);
	wait(100);
	print(center_x(sizeof(NADEON) - 1,OLED_FONT_LARGE_WIDTH),center_y(OLED_FONT_LARGE_HEIGHT),OLED_FONT_LARGE,OLED_WHITE,NADEON[0]); 	// display SAVED... centered in X Y
	//call(rgb)
}// display mods
