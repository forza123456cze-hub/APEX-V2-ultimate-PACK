				if(modName_idx == 2) vals_available(5  , 5 );		
				if(modName_idx == 5) vals_available(6 ,6 ); 
				if(modName_idx == 7) vals_available(7 ,8 );
				if(modName_idx == 8) vals_available(9, 11 ); 
				if(modName_idx == 9) vals_available(12, 14 );
				if(modName_idx == 17) vals_available(15, 15 );
