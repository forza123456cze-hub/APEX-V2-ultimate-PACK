combo rgb {
	wait(1);
  set_rgb(colorledx, colorledx[1], colorledx[2]);
  colorledx[decled] -= 5; colorledx[incled] += 5;
  if(!colorledx[decled]) { incled = (incled + 1) % 3; decled = (decled + 1) % 3; }
  }
