function toggle(f_idx, f_val) { // toggle_antirecoil[profile_idx] = toggle(1, PS4_UP, toggle_antirecoil[profile_idx]);
	
	if(event_press(PS4_UP))
	{
		if(modName_idx == f_idx)
		{
			if(modName_idx == 16)
			{
			// Increase
				f_val += 1;
			// Limits
				if(f_val > 7)
					f_val = 0;
				if(f_val < 0)
					f_val = 7;
			}
				else if(modName_idx == 0)
			{
			// Increase
				f_val += 1;
			// Limits
				if(f_val > 18)
					f_val = 0;
				if(f_val < 0)
					f_val =18;
			}
			 else if(modName_idx == 3)
			{
			// Increase
				f_val += 1;
			// Limits
				if(f_val > 3)
					f_val = 0;
				if(f_val < 0)
					f_val = 3;
			}
			else 
			f_val = 1;
			combo_run(RUMBLE_ON);
		}
		
		display_new = TRUE;
	}
			
	if(event_press(PS4_DOWN))
	{
		if(modName_idx == f_idx)
		
		{
		if(modName_idx == 16)
			{
			// Decrease
				f_val -= 1;
			// Limits
				if(f_val > 7)
					f_val = 0;
				if(f_val < 0)
					f_val = 7;
			}
		else if(modName_idx == 0)
			{
			// Decrease
				f_val -= 1;
			// Limits
				if(f_val > 18)
					f_val = 0;
				if(f_val < 0)
					f_val = 18;
			}	
			else if(modName_idx == 3)
			{
			// Decrease
				f_val -= 1;
			// Limits
				if(f_val > 3)
					f_val = 0;
				if(f_val < 0)
					f_val = 3;
			}	
		else	f_val = 0;
			combo_run(RUMBLE_OFF);
			
		}		
		display_new = TRUE;
	}
	return f_val;
}
