			    RADIUS [profile_idx]               						= edit_val( 9 , RADIUS[profile_idx]                , 0 , 99   , 1  , 10   );
                STEPS [profile_idx]                						= edit_val( 10 , STEPS[profile_idx]                 , 0 , 99   , 1  , 10   ); 
                polar_boost[profile_idx]           						= edit_val( 11 , polar_boost[profile_idx]          , 0 , 10   , 1  , 10   );
                stickyaim_size [profile_idx]       						= edit_val( 12 , stickyaim_size[profile_idx]        , 0 , 50   , 1  , 10   );
                stickyaim_time  [profile_idx]      						= edit_val( 13 , stickyaim_time [profile_idx]       , 0 , 990  , 1  , 10   );
                stickyaim_boost  [profile_idx]     						= edit_val( 14 , stickyaim_boost [profile_idx]     , 0 , 10  , 1  , 10   );
                autoshield_time    				   						= edit_val( 15 , autoshield_time     , 0 , 990  , 1  , 10   );
