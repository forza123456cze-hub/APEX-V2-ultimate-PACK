        if (v_idx==3) { f_lin(3, 18, tac_3[0], c_snp, 1); f_lin(4, 30, tac_4[0], c_blm, 1); f_lin(5, 42, tac_5[0], c_akm, 1); f_lin(6, 54, tac_6[0], c_apg, 1); }
