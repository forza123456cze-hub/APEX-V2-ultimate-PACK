combo c_sav {
    v_act=0; cls_oled(0); rect_oled(0, 0, 127, 64, 1, 1); print(10, 26, OLED_FONT_SMALL, 0, str_3[0]); wait(800); 
    
    set_pvar(SPVAR_1, c_aae); set_pvar(SPVAR_2, c_aar); set_pvar(SPVAR_3, c_aas); set_pvar(SPVAR_4, c_aah); 
    set_pvar(SPVAR_5, c_arv); set_pvar(SPVAR_6, c_arh); set_pvar(SPVAR_7, c_arv2); set_pvar(SPVAR_8, c_arh2); 
    set_pvar(SPVAR_9, c_are); set_pvar(SPVAR_10, c_hlp); set_pvar(SPVAR_11, c_flw); set_pvar(SPVAR_12, v_dz); 
    set_pvar(SPVAR_13, c_lay); set_pvar(SPVAR_16, c_rpm); 
    
    v_bls = 0;
    if (c_asm) v_bls += 1;    if (c_flo) v_bls += 2;    if (c_sta) v_bls += 4;
    if (c_hlx) v_bls += 8;    if (c_htr) v_bls += 16;   if (c_snp) v_bls += 32;
    if (c_blm) v_bls += 64;   if (c_akm) v_bls += 128;  if (c_apg) v_bls += 256;
    if (c_abr) v_bls += 512;  if (c_ovr) v_bls += 1024; if (c_blk) v_bls += 2048;
    if (_SldCnc) v_bls += 4096; if (_YYSpam) v_bls += 8192;
    set_pvar(SPVAR_14, v_bls);
    
    v_drw=1; v_saw=1; v_stt=0; 
}

