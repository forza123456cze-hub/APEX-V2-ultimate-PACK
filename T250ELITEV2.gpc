function f_lin(I, Y, A, V, F) {
    v_tc1 = 1; 
    if (v_cur == I) { v_tc1 = 0; rect_oled(2, Y - 1, 124, 12, 1, 1); }
    print(6, Y, OLED_FONT_SMALL, v_tc1, A);
    if (F == 0) { 
        if (V < 0) { putc_oled(1, 45); V = abs(V); } else { putc_oled(1, 32); } 
        putc_oled(2, (V / 10) + 48); 
        putc_oled(3, (V % 10) + 48); 
        puts_oled(95, Y, OLED_FONT_SMALL, 3, v_tc1); 
    }
    if (F == 1) { if (V) print(98, Y, OLED_FONT_SMALL, v_tc1, str_7[0]); else print(98, Y, OLED_FONT_SMALL, v_tc1, str_8[0]); }
    if (F == 2) { if (V == 0) print(76, Y, OLED_FONT_SMALL, v_tc1, _E0[0]); if (V == 1) print(76, Y, OLED_FONT_SMALL, v_tc1, _E1[0]); if (V == 2) print(76, Y, OLED_FONT_SMALL, v_tc1, _E2[0]); if (V == 3) print(76, Y, OLED_FONT_SMALL, v_tc1, _E3[0]); if (V == 4) print(76, Y, OLED_FONT_SMALL, v_tc1, _E4[0]); if (V == 5) print(76, Y, OLED_FONT_SMALL, v_tc1, _E5[0]); }
    if (F == 3) { if (V == 0) print(76, Y, OLED_FONT_SMALL, v_tc1, lyt_0[0]); if (V == 1) print(76, Y, OLED_FONT_SMALL, v_tc1, lyt_1[0]); if (V == 2) print(76, Y, OLED_FONT_SMALL, v_tc1, lyt_2[0]); if (V == 3) print(76, Y, OLED_FONT_SMALL, v_tc1, lyt_3[0]); if (V == 4) print(76, Y, OLED_FONT_SMALL, v_tc1, lyt_4[0]); if (V == 5) print(76, Y, OLED_FONT_SMALL, v_tc1, lyt_5[0]); if (V == 6) print(76, Y, OLED_FONT_SMALL, v_tc1, lyt_6[0]); if (V == 7) print(76, Y, OLED_FONT_SMALL, v_tc1, lyt_7[0]); }
    if (F == 4) { if (V == 0) print(76, Y, OLED_FONT_SMALL, v_tc1, str_H[0]); if (V == 1) print(76, Y, OLED_FONT_SMALL, v_tc1, str_I[0]); if (V == 2) print(76, Y, OLED_FONT_SMALL, v_tc1, str_J[0]); if (V == 3) print(76, Y, OLED_FONT_SMALL, v_tc1, str_K[0]); }
}

function f_mod(D) {
    if (v_cat == 0) { if (v_cur == 0) { c_aae += D; if (c_aae > 5) c_aae = 0; if (c_aae < 0) c_aae = 5; } if (v_cur == 1) c_aar = clamp(c_aar + D, 1, 50); if (v_cur == 2) c_aas = clamp(c_aas + D, 1, 50); if (v_cur == 3) c_aah = clamp(c_aah + D, 0, 50); if (v_cur == 4) c_asm = !c_asm; }
    if (v_cat == 1) { if (v_cur == 0) { c_are += D; if (c_are > 3) c_are = 0; if (c_are < 0) c_are = 3; } if (v_cur == 1) c_arv = clamp(c_arv + D, -100, 100); if (v_cur == 2) c_arh = clamp(c_arh + D, -100, 100); if (v_cur == 3) c_arv2 = clamp(c_arv2 + D, -100, 100); if (v_cur == 4) c_arh2 = clamp(c_arh2 + D, -100, 100); if (v_cur == 5) c_flo = !c_flo; if (v_cur == 6) c_flw = clamp(c_flw + D, 0, 50); if (v_cur == 7) c_sta = !c_sta; if (v_cur == 8) c_rpm = clamp(c_rpm + D, 30, 99); }
    if (v_cat == 2) { if (v_cur == 0) c_hlx = !c_hlx; if (v_cur == 1) c_hlp = clamp(c_hlp + D, 0, 100); if (v_cur == 2) c_htr = !c_htr; if (v_cur == 3) c_snp = !c_snp; if (v_cur == 4) c_blm = !c_blm; if (v_cur == 5) c_akm = !c_akm; if (v_cur == 6) c_apg = !c_apg; if (v_cur == 7) c_abr = !c_abr; if (v_cur == 8) _SldCnc = !_SldCnc; if (v_cur == 9) _YYSpam = !_YYSpam; }
    if (v_cat == 3) { if (v_cur == 0) { c_lay += D; if (c_lay > 7) c_lay = 0; if (c_lay < 0) c_lay = 7; } if (v_cur == 1) c_ovr = !c_ovr; if (v_cur == 2) c_blk = !c_blk; if (v_cur == 3) v_dz = clamp(v_dz + D, 0, 20); }
