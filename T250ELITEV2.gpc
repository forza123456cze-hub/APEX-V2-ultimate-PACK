        if (v_idx==5) { f_lin(5, 18, tac_5[0], c_akm, 1); f_lin(6, 30, tac_6[0], c_apg, 1); f_lin(7, 42, tac_7[0], c_abr, 1); f_lin(8, 54, tac_8[0], _SldCnc, 1); }
