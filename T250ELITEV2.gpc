        if (v_idx==3) { f_lin(3, 18, rec_3[0], c_arv2, 0); f_lin(4, 30, rec_4[0], c_arh2, 0); f_lin(5, 42, rec_5[0], c_flo, 1); f_lin(6, 54, rec_6[0], c_flw, 0); }
        if (v_idx==4) { f_lin(4, 18, rec_4[0], c_arh2, 0); f_lin(5, 30, rec_5[0], c_flo, 1); f_lin(6, 42, rec_6[0], c_flw, 0); f_lin(7, 54, rec_7[0], c_sta, 1); }
        if (v_idx==5) { f_lin(5, 18, rec_5[0], c_flo, 1); f_lin(6, 30, rec_6[0], c_flw, 0); f_lin(7, 42, rec_7[0], c_sta, 1); f_lin(8, 54, rec_8[0], c_rpm, 0); }
    }
    if (v_cat==2) { 
        if (v_idx==0) { f_lin(0, 18, tac_0[0], c_hlx, 1); f_lin(1, 30, tac_1[0], c_hlp, 0); f_lin(2, 42, tac_2[0], c_htr, 1); f_lin(3, 54, tac_3[0], c_snp, 1); } 
        if (v_idx==1) { f_lin(1, 18, tac_1[0], c_hlp, 0); f_lin(2, 30, tac_2[0], c_htr, 1); f_lin(3, 42, tac_3[0], c_snp, 1); f_lin(4, 54, tac_4[0], c_blm, 1); } 
