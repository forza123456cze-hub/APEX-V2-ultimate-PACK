init {
    cls_oled(0); v_drw=1; 
    v_ast=get_pvar(SPVAR_15,0,2,0); 
    if (v_ast == 1) { v_phs = 1; } else if (v_ast == 2) { v_phs = 99; } else { v_phs = 4; }                  
    
    c_aae=get_pvar(SPVAR_1,0,5,0); c_aar=get_pvar(SPVAR_2,1,50,20); c_aas=get_pvar(SPVAR_3,1,50,20); c_aah=get_pvar(SPVAR_4,0,50,15);
    c_arv=get_pvar(SPVAR_5,-100,100,28); c_arh=get_pvar(SPVAR_6,-100,100,0); c_arv2=get_pvar(SPVAR_7,-100,100,38); c_arh2=get_pvar(SPVAR_8,-100,100,0); 
    c_are=get_pvar(SPVAR_9,0,3,0); c_hlp=get_pvar(SPVAR_10,10,99,40); c_flw=get_pvar(SPVAR_11,0,50,18); v_dz=get_pvar(SPVAR_12,0,20,3); 
    c_lay=get_pvar(SPVAR_13,0,7,0); c_rpm=get_pvar(SPVAR_16,30,99,60); 
    
    v_bls = get_pvar(SPVAR_14, 0, 32767, 511);
    c_asm=(v_bls)&1; c_flo=(v_bls>>1)&1; c_sta=(v_bls>>2)&1; c_hlx=(v_bls>>3)&1; 
    c_htr=(v_bls>>4)&1; c_snp=(v_bls>>5)&1; c_blm=(v_bls>>6)&1; c_akm=(v_bls>>7)&1;
    c_apg=(v_bls>>8)&1; c_abr=(v_bls>>9)&1; c_ovr=(v_bls>>10)&1; c_blk=(v_bls>>11)&1;
    _SldCnc=(v_bls>>12)&1; _YYSpam=(v_bls>>13)&1;
    
    set_led(LED_1,0); set_led(LED_2,1); set_led(LED_3,0); set_led(LED_4,0); 
}

main {
    if (c_ovr) vm_tctrl(-8); else vm_tctrl(0);
    if (c_blk) block_rumble();
    
    SWAP_BTN = PS4_TRIANGLE;
    
    phys_rx = get_ival(S_RX); if (abs(phys_rx) <= v_dz) phys_rx = 0;
    phys_ry = get_ival(S_RY); if (abs(phys_ry) <= v_dz) phys_ry = 0;
    phys_lx = get_ival(S_LX); if (abs(phys_lx) <= v_dz) phys_lx = 0;
    phys_ly = get_ival(S_LY); if (abs(phys_ly) <= v_dz) phys_ly = 0;
    
    if (c_lay==0) { v_fr=PS4_R2; v_ad=PS4_L2; v_cr=PS4_CIRCLE; v_jm=PS4_CROSS; PING_BTN=PS4_UP; } 
    if (c_lay==1) { v_fr=PS4_R2; v_ad=PS4_L2; v_cr=PS4_R3; v_jm=PS4_CROSS; PING_BTN=PS4_UP; } 
    if (c_lay==2) { v_fr=PS4_R2; v_ad=PS4_L2; v_cr=PS4_CIRCLE; v_jm=PS4_R3; PING_BTN=PS4_UP; } 
    if (c_lay==3) { v_fr=PS4_R2; v_ad=PS4_L2; v_cr=PS4_CIRCLE; v_jm=PS4_L1; PING_BTN=PS4_UP; } 
    if (c_lay==4) { v_fr=PS4_R1; v_ad=PS4_L1; v_cr=PS4_CIRCLE; v_jm=PS4_CROSS; PING_BTN=PS4_UP; } 
    if (c_lay==5) { v_fr=PS4_R1; v_ad=PS4_L1; v_cr=PS4_R3; v_jm=PS4_CROSS; PING_BTN=PS4_UP; } 
    if (c_lay==6) { v_fr=PS4_R1; v_ad=PS4_L1; v_cr=PS4_CIRCLE; v_jm=PS4_R3; PING_BTN=PS4_UP; } 
    if (c_lay==7) { v_fr=PS4_R1; v_ad=PS4_L1; v_cr=PS4_CIRCLE; v_jm=PS4_L2; PING_BTN=PS4_UP; }

    if (v_phs==4) {
        if (v_drw) { cls_oled(0); print(20, 10, OLED_FONT_SMALL, 1, str_4[0]); rect_oled(20, 30, 16, 16, 1, 0); rect_oled(44, 30, 16, 16, 1, 0); rect_oled(68, 30, 16, 16, 1, 0); rect_oled(92, 30, 16, 16, 1, 0); if (v_pi > 0) rect_oled(22, 32, 12, 12, 1, 1); if (v_pi > 1) rect_oled(46, 32, 12, 12, 1, 1); if (v_pi > 2) rect_oled(70, 32, 12, 12, 1, 1); if (v_pi > 3) rect_oled(94, 32, 12, 12, 1, 1); v_drw = 0; }
        set_val(PS4_RX, 0); set_val(PS4_RY, 0); set_val(PS4_LX, 0); set_val(PS4_LY, 0); set_val(PS4_R2, 0); set_val(PS4_L2, 0);
        if (event_press(PS4_UP) || event_press(PS4_DOWN) || event_press(PS4_LEFT) || event_press(PS4_RIGHT) || event_press(PS4_CROSS) || event_press(PS4_CIRCLE) || event_press(PS4_SQUARE) || event_press(PS4_TRIANGLE) || event_press(PS4_L1) || event_press(PS4_R1)) {
            if (event_press(PIN_SEQ[v_pi])) { v_pi++; v_drw=1; if (v_pi >= 4) { cls_oled(0); print(35, 25, OLED_FONT_SMALL, 1, _MSG_ACC[0]); set_pvar(SPVAR_15, 1); v_phs=1; v_tmr=-800; v_drw=1; } } else { v_flc++; v_pi=0; v_drw=1; if (v_flc >= 3) { v_phs=99; v_drw=1; } }
        }
    }

    if (v_phs==1) {
        v_tmr += get_rtime();
        if (v_drw == 1) { cls_oled(0); v_drw = 2; }
        if (v_tmr > 0 && v_drw == 2) { rect_oled(38, 4, 52, 20, 1, 1); rect_oled(34, 14, 60, 16, 1, 1); v_drw = 3; }
        if (v_tmr > 600 && v_drw == 3) { rect_oled(42, 18, 14, 10, 1, 0); rect_oled(72, 18, 14, 10, 1, 0); rect_oled(62, 28, 4, 6, 1, 0); v_drw = 4; }
        if (v_tmr > 1000 && v_drw == 4) { rect_oled(46, 30, 36, 18, 1, 1); rect_oled(49, 38, 2, 8, 1, 0); rect_oled(54, 38, 2, 8, 1, 0); rect_oled(59, 38, 2, 8, 1, 0); rect_oled(67, 38, 2, 8, 1, 0); rect_oled(72, 38, 2, 8, 1, 0); rect_oled(77, 38, 2, 8, 1, 0); rect_oled(46, 41, 36, 2, 1, 0); v_drw = 5; }
        if (v_tmr > 1400 && v_drw == 5) { print(48, 3, OLED_FONT_MEDIUM, 0, str_6[0]); v_drw = 6; }
        if (v_tmr > 1600) { if (v_drw == 6) { print(20, 52, OLED_FONT_SMALL, 1, str_2[0]); v_drw = 7; } if ((v_tmr % 100) < 50 && v_drw == 7) { rect_oled(42, 18, 14, 10, 1, 1); rect_oled(72, 18, 14, 10, 1, 1); v_drw = 8; } else if ((v_tmr % 100) >= 50 && v_drw == 8) { rect_oled(42, 18, 14, 10, 1, 0); rect_oled(72, 18, 14, 10, 1, 0); v_drw = 7; } }
        if (v_tmr > 2500) { v_tmr=0; v_drw=1; v_saw=1; v_stt=0; v_phs=0; }
    }
    
    if (v_phs==99) { if (v_drw) { cls_oled(0); print(16, 26, OLED_FONT_SMALL, 1, str_5[0]); v_drw=0; } set_val(PS4_RX, 0); set_val(PS4_RY, 0); set_val(PS4_LX, 0); set_val(PS4_LY, 0); set_val(PS4_R2, 0); set_val(PS4_L2, 0); }
    
    if (v_phs==0) {
        if (get_ival(v_ad) || get_ival(BTN_OPT)) { if (!v_saw) { v_saw=1; v_drw=1; } v_stt=0; }
        if (get_ival(v_ad) && event_press(BTN_OPT)) { v_act = !v_act; v_cat=0; v_cur=0; v_drw=1; set_val(BTN_OPT, 0); }
        
        if (v_act && !combo_running(c_sav)) {
            v_stt = 0; set_val(PS4_UP, 0); set_val(PS4_DOWN, 0); set_val(PS4_LEFT, 0); set_val(PS4_RIGHT, 0); set_val(PS4_L1, 0); set_val(PS4_R1, 0); set_val(PS4_L2, 0); set_val(PS4_R2, 0); set_val(PS4_L3, 0); set_val(PS4_R3, 0); set_val(PS4_SHARE, 0); set_val(PS4_OPTIONS, 0); set_val(PS4_CROSS, 0); set_val(PS4_CIRCLE, 0); set_val(PS4_SQUARE, 0); set_val(PS4_TRIANGLE, 0); set_val(PS4_RX, 0); set_val(PS4_RY, 0); set_val(PS4_LX, 0); set_val(PS4_LY, 0);
            if (v_cat==0) v_mx = 4; if (v_cat==1) v_mx = 8; if (v_cat==2) v_mx = 9; if (v_cat==3) v_mx = 3;
            if (event_press(PS4_DOWN)) { v_cur++; if (v_cur > v_mx) v_cur=0; v_drw=1; }
            if (event_press(PS4_UP)) { v_cur--; if (v_cur < 0) v_cur=v_mx; v_drw=1; }
            if (event_press(BTN_R1)) { v_cat++; if (v_cat > 3) v_cat=0; v_cur=0; v_drw=1; }
            if (event_press(BTN_L1)) { v_cat--; if (v_cat < 0) v_cat=3; v_cur=0; v_drw=1; }
            if (event_press(PS4_RIGHT)) { f_mod(1); v_drw=1; }
            if (event_press(PS4_LEFT)) { f_mod(-1); v_drw=1; }
            if (event_press(BTN_O)) { combo_run(c_sav); }
            if (v_drw && !combo_running(c_sav)) { f_gui(); v_drw=0; }
        }
        
        if (!v_act) {
            if (v_saw) {
                v_stt += get_rtime();
                if (v_stt > 15000) { cls_oled(0); v_saw=0; v_drw=0; } 
                else if (v_drw && !combo_running(c_sav)) { 
                    cls_oled(0); rect_oled(2, 2, 124, 60, 1, 0); 
                    print(16, 20, OLED_FONT_MEDIUM, 1, str_0[0]); print(16, 42, OLED_FONT_SMALL, 1, str_1[0]); 
                    if (_Prof==0) print(19, 52, OLED_FONT_SMALL, 1, _TXT_AR[0]);
                    else print(19, 52, OLED_FONT_SMALL, 1, _TXT_SMG[0]);
                    v_drw=0;
                }
            }
            if (get_ival(v_ad) || get_ival(BTN_L1)) { 
                if (event_press(PS4_LEFT)) { _Prof=0; v_saw=1; v_drw=1; v_stt=0; }
                if (event_press(PS4_RIGHT)){ _Prof=1; v_saw=1; v_drw=1; v_stt=0; }
            }
            if (_Prof==0) { set_led(LED_1, 0); set_led(LED_2, 1); set_led(LED_3, 0); set_led(LED_4, 0); } 
            if (_Prof==1) { set_led(LED_1, 0); set_led(LED_2, 0); set_led(LED_3, 1); set_led(LED_4, 0); } 
            
            
            if (c_snp && get_ival(v_ad) >= 90) { v_tmr += get_rtime(); if (v_tmr > 300) v_tmr = 0; if (v_tmr < 20) set_val(v_ad, 90); }
            if (c_blm && get_ival(v_fr) == 100 && get_ptime(v_fr) > 500) { bloom_tmr += get_rtime(); if (bloom_tmr > 800) bloom_tmr = 0; if (bloom_tmr < 20) set_val(v_fr, 0); } else bloom_tmr = 0;
            if (c_akm && get_ival(v_fr)) { set_val(v_fr, 0); set_val(v_ad, 0); combo_run(c_akm_f); }
            if (c_apg && get_ival(v_ad)) { ping_tmr += get_rtime(); if (ping_tmr == 200) combo_run(c_ping); } else ping_tmr = 0;
            if (c_abr && get_ival(v_ad) > 80) set_val(BTN_L3, 100);
            if (_SldCnc && abs(phys_ly) > 70 && event_press(v_cr)) combo_run(c_slide_cancel);
            if (_YYSpam && get_ival(PS4_TRIANGLE) && get_ptime(PS4_TRIANGLE) > 200) combo_run(c_yyspam);
            
            if (c_hlx && get_ival(v_fr)) { h_ang = (get_rtime() / 4) % 220; set_val(S_LX, clamp(get_ival(S_LX) + (_Cos[h_ang] * c_hlp) / 100, -100, 100)); set_val(S_LY, clamp(get_ival(S_LY) + (_Sin[h_ang] * c_hlp) / 100, -100, 100)); }

            if (event_press(v_ad)) v_snt = 250;
            
            if (c_aae != 5 && (get_ival(v_ad) || get_ival(v_fr))) { 
                v_mag = isqrt(pow(phys_rx, 2) + pow(phys_ry, 2));
                v_max = (v_mag < 100);
                aa_tmr += get_rtime();
                if (aa_tmr >= 16) { 
                    aa_tmr -= 16; 
                    if (v_snt > 0) { v_snt -= 16; v_ang = (v_ang + ((c_aas * 150) / 100)) % 220; v_rad_c = (c_aar * 150) / 100; } else { v_ang = (v_ang + c_aas) % 220; v_rad_c = c_aar; }
                    if (v_mag < 12) v_rad_c = 2; else if (v_mag < 40) v_rad_c = c_aar + 10;
                    idx2 = (v_ang * 2) % 220; 
                    
                    if (c_aae == 0) { v_cos = (_Cos[v_ang] * v_rad_c) / 100; v_sin = (_Sin[v_ang] * v_rad_c) / 100; }
                    else if (c_aae == 1) { v_kpx = v_kpx + (v_kqx * (phys_rx - v_kpx)) / 1000; v_kpy = v_kpy + (100 * (phys_ry - v_kpy)) / 1000; v_cos = (_Cos[v_ang] * v_rad_c) / 100; v_sin = (_Sin[v_ang] * v_rad_c) / 100; if (v_mag > v_rad_c && v_rad_c > 0) { v_sin = (v_sin * (200 - ((abs(v_kpy) + v_mag) / 10) * 10) / 200) * v_max; v_cos = (v_cos * (200 - ((abs(v_kpx) + v_mag) / 10) * 10) / 200) * v_max; } else { v_sin -= v_kpy; v_cos -= v_kpx; } }
                    else if (c_aae == 2) { v_cos = (_Cos[v_ang] * (v_rad_c + 5)) / 100; v_sin = (_Sin[v_ang] * (v_rad_c + 5)) / 100; }
                    else if (c_aae == 3) { v_cos = (_Cos[v_ang] * v_rad_c) / 100; v_sin = (_Sin[idx2] * v_rad_c) / 100; }
                    else if (c_aae == 4) { v_cos = (_Cos[v_ang] * v_rad_c) / 100; v_sin = (_Cos[idx2] * v_rad_c) / 100; }
                    
                    v_sin = (v_sin * 140) / 100;
                    
                    if (c_asm && v_rad_c > 0) { if (v_cos > v_smx + 2) v_smx += 2; else if (v_cos < v_smx - 2) v_smx -= 2; else v_smx = v_cos; if (v_sin > v_smy + 2) v_smy += 2; else if (v_sin < v_smy - 2) v_smy -= 2; else v_smy = v_sin; } else if (v_rad_c == 0) { v_smx = 0; v_smy = 0; } else { v_smx = v_cos; v_smy = v_sin; }
                }
                head_y_apply = 0; if (get_ival(v_fr)) head_y_apply = c_aah;
                if (v_mag < 85) { set_val(S_RX, clamp(phys_rx + v_smx, -100, 100)); set_val(S_RY, clamp(phys_ry + (v_smy - head_y_apply), -100, 100)); }
            } else { v_snt = 0; aa_tmr = 0; }
            
            if (c_flo && get_ival(v_ad) && get_ival(v_fr)) { current_flinch = get_rumble(RUMBLE_A); if (get_rumble(RUMBLE_B) > current_flinch) current_flinch = get_rumble(RUMBLE_B); if (current_flinch > 10) set_val(S_RY, clamp(get_ival(S_RY) + ((current_flinch * c_flw) / 40), -100, 100)); }
            
            v_ary = get_ival(S_RY); v_arx = get_ival(S_RX);
            if (get_ival(v_fr) && get_ival(v_ad)) {
                v_sht += get_rtime();
                if (_Prof == 0) { applied_y = c_arv; applied_x = c_arh; } else { applied_y = c_arv2; applied_x = c_arh2; }
                if (c_sta && get_ival(v_cr)) applied_y = (applied_y * 60) / 100;
                
                if (c_are == 1) { if (abs(v_ary) > 5) applied_y = (applied_y * (100 - abs(v_ary))) / 100; if (abs(v_arx) > 5) applied_x = (applied_x * (100 - abs(v_arx))) / 100; }
                else if (c_are == 2) { noise = (v_sht % 30) - 15; applied_y += (applied_y * noise / 100); applied_x += (applied_x * noise / 100); }
                else if (c_are == 3) { pulse_rate = 60000 / (c_rpm * 10); if ((v_sht % pulse_rate) > (pulse_rate / 2)) { applied_y = 0; applied_x = 0; } }

                if (abs(v_ary) > 40) applied_y = 0; if (abs(v_arx) > 40) applied_x = 0; 
                set_val(S_RY, clamp(v_ary + applied_y, -100, 100)); set_val(S_RX, clamp(v_arx + applied_x, -100, 100));
            } else v_sht = 0;
        }
    }
}

combo c_slide_cancel { set_val(v_cr, 100); wait(120); set_val(v_jm, 100); wait(50); }
combo c_yyspam { set_val(PS4_TRIANGLE, 100); wait(20); set_val(PS4_TRIANGLE, 0); wait(65); }
combo c_ping { set_val(PS4_UP, 100); wait(50); set_val(PS4_UP, 0); wait(100); }
