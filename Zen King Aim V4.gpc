// Enumeration
enum {
	// Aim Assist elements
	AimAngle = 2, RotationAngle, AimRadius, RotationRadius, AimSpeed, RotationSpeed,
	
	// Anti Drift elements
	LowerBound = 0, UpperBound, StickValue, CorrectionFactor,
	
	// Anti Recoil elements
	X = 0, Y, X_Change, Y_Change,
	HasHorizontal, CurrentStep, CurrentStepTime, RecoilStartPosition, StartPosition, StepCount, StepTime,
	
	// Button Layout elements
	ADS = 0, Lethal, Ping, Focus, Fire, SwitchWeapon, Action, Jump, Melee, Reload, Tact,
	
	// Button Layout identifiers
	Default = 0, Tactical, Lefty, NomadCharlie, NomadCharlieTactical, NomadCharlieLefty, BumperJumper, BumperJumperTactical, OneHandGunslinger, StickAndMove, Brawler, Beast,
	
	// Color elements
	Hue = 0, Saturation, Brightness,
	
	// Color identifiers
	Green = 0, Purple, Yellow, Red, White, MenuRed, MenuGreen, MenuPurple,
	
	// Display elements
	Update = 0, UpdateLed, Buffer, BufferCopyValue, BufferDigitCount, BufferDigits,
	
	// Display identifiers
	AlignCenter = -3, AlignBottom = -2, AlignRight = -1, AlignLeft = 2, AlignTop = 5,
	
	// Menu elements
	Page = 0, Minimum, Maximum, Type, MenuCategory, MenuWeapon = MenuCategory + 2,
	
	// Script Version elements
	Major = 0, Minor,
	
	// Settings elements
	ButtonLayout = 0, StickLayout,
	TrackingAssist, TrackingSize = TrackingAssist + 3, TrackingSpeed = TrackingSize + 3, BoostAssist = TrackingSpeed + 3, BoostSize = BoostAssist + 3, BoostSpeed = BoostSize + 3, StrafeAssist = BoostSpeed + 3, StrafeSize = StrafeAssist + 3, StrafeSpeed = StrafeSize + 3,
	BlockVibration = StrafeSpeed + 3, Flipped, Inverted, DeadzoneLeft, DeadzoneRight, BunnyHop, PingOnFire, SniperMode = PingOnFire + 3, SlideCancel = SniperMode + 3, YY,
	Vertical,
	DefaultCategory, DefaultWeapon = DefaultCategory + 2,
	VerticalValue = DefaultWeapon + 2, HorizontalValue = VerticalValue + 2,
	
	// Strings identifiers
	GroundLoot_VerticalStrength = 0,
	Home_Author = 0, Home_Title, Home_Version,
	Setting_String = 1, Setting_Boolean, Setting_Number = 4, Setting_Timer = 8, Setting_Profile = 16,
	TrackingAssistEdit = TrackingAssist, TrackingSizeEdit, TrackingSpeedEdit, BoostAssistEdit, BoostSizeEdit, BoostSpeedEdit, StrafeAssistEdit, StrafeSizeEdit, StrafeSpeedEdit,
	BlockVibrationEdit, FlippedEdit, InvertedEdit, DeadzoneLeftEdit, DeadzoneRightEdit, BunnyHopEdit, PingOnFireEdit, SniperModeEdit, SlideCancelEdit, YYEdit,
	
   	// SPVAR elements
	Bit = 0, Bits, Slot, Temp, Value,
	
	// State elements
	HoldingADS = 0, HoldingFire, Stance, ButtonBlock, ButtonHoldTime, CurrentProfile, MenuProfile, Screen, ScreenSaver, StrafeComboSize, StrafeComboTime, PolarRadius,
	
	// State identifiers
	HomeScreen = 0, MenuScreen, GroundLootScreen, WeaponSelectScreen, WeaponSelectRecoilScreen,
	Primary = 0, Secondary, GroundLoot,
	
	// Stick Layout elements
  	Move = 0, Strafe, Look, Rotate, SprintButton,
  	
    // Stick Layout identifiers
    Southpaw = 1, Legacy, LegacySouthpaw, SouthpawNoClickSwap, LegacySouthpawNoClickSwap,
	
	// Weapon elements
	Weapon = 0, Category = Weapon + 2,
	
	// Weapon Select identifiers
	AR = 0, SMG, LMG, Other
}

// Variables
int i;
int aimassist[8];
int antidrift[4];
int antirecoil[11];
int button[11];
int display[15];
int menu[8];
int rumble;
int settings[52];
int spvar[5];
int state[12];
int stick[5];
int weapon[4];

init {
	SettingsLoad();
}

main {
	HandleDisplayUpdate();
	HandleLedUpdate();
	HandleDeviceInput();
	HandleDeviceOutput();
}

// Adjusts a weapon selection recoil value
function AdjustRecoilValue(setting, adjustment) {
	settings[setting] = AdjustValue(settings[setting], -100, 100, adjustment, FALSE);
}

// Adjusts a value within bounds, with optional cycling
function AdjustValue(value, lower, upper, adjustment, cyclable) {
	// Check if adjustment is within bounds
	if(((value + adjustment) >= lower) && ((value + adjustment) <= upper)) {
		LedAlert(MenuGreen);
		return value + adjustment;
	}
	
	// Handle cycling, if enabled
	if(cyclable) {
		if((adjustment > 0) && ((value + adjustment) > upper)) {
			LedAlert(MenuGreen); // Indicate success
			return lower; // Return the new value
		} else if((adjustment < 0) && ((value + adjustment) < lower)) {
			LedAlert(MenuGreen); // Indicate success
			return upper; // Return the new value
		}
	}
	
	// If adjustment is not possible, indicate failure and clamp to bounds
	LedAlert(MenuRed);
	
	// Return the value clamped to bounds
	return iif(adjustment > 0, upper, lower);
}

// This function calculates a percentage of a value
function CalculatePercentage(input, percentage) {
    return (input * percentage) / 100;
}

// This function calculates the step change amount
function CalculateStepChange(index, step) {
	// Check if there are no further steps
	if(step >= antirecoil[StepCount]) {
		return 0;
	}
	
	// Determine which recoil data is being used
	switch(weapon[Category + state[CurrentProfile]]) {
		case AR {
			return ((_arRecoilData[index + step + 1] - _arRecoilData[index + step]) * 328) / (antirecoil[StepTime] / get_rtime());
		}
		case SMG {
			return ((_smgRecoilData[index + step + 1] - _smgRecoilData[index + step]) * 328) / (antirecoil[StepTime] / get_rtime());
		}
		case LMG {
			return ((_lmgRecoilData[index + step + 1] - _lmgRecoilData[index + step]) * 328) / (antirecoil[StepTime] / get_rtime());
		}
		case Other {
			return ((_otherRecoilData[index + step + 1] - _otherRecoilData[index + step]) * 328) / (antirecoil[StepTime] / get_rtime());
		}
	}
	
	// No anti-recoil
	return 0;
}

// This function calculates the horizontal and vertical step change values
function CalculateStepChangeValues() {
	antirecoil[X_Change] = CalculateStepChange(antirecoil[RecoilStartPosition] + antirecoil[StepCount], antirecoil[CurrentStep]);
	antirecoil[Y_Change] = CalculateStepChange(antirecoil[RecoilStartPosition], antirecoil[CurrentStep]);
}

// Changes profiles
function ChangeProfile(new_profile) {
	// Cycle profiles
	state[CurrentProfile] = new_profile;
	
	// Draw the current profile
	DrawProfile();
	
	// Update strafe combo time
	state[StrafeComboTime] = settings[StrafeSpeed + state[CurrentProfile]] * get_rtime();
	
	// Indicate the LED should be updated
	display[UpdateLed] = TRUE;
}

// Draws the name of the profile being used, and weapon
function DrawProfile() {
	// Clear the screen, reset the screen saver and print the profile name
	cls_oled(OLED_BLACK);
	ResetDisplay(FALSE);
	
	// Determine how to print the profile name
	if(state[CurrentProfile] == 2) {
		PrintString(AlignCenter, AlignCenter, OLED_FONT_MEDIUM, OLED_WHITE, GetProfileString());
	} else {
		// Print profile name
		PrintString(AlignCenter, AlignTop, OLED_FONT_MEDIUM, OLED_WHITE, GetProfileString());
		
		// Print weapon name
		PrintString(AlignCenter, 23, OLED_FONT_MEDIUM, OLED_WHITE, GetWeaponName(weapon[Weapon + state[CurrentProfile]]));
	}
}

// Changes script screen
function ChangeScreen(screen) {
	// Update the script state
	state[Screen] = screen;
	display[Buffer] = 1;
	
	// Reset any button block and screen saver
	ResetButtonBlock();
	ResetDisplay(TRUE);
	
	// Reset device speed
	vm_tctrl(iif(state[Screen] == HomeScreen, VM_SPEED - 10, 0));
	
	// Check for setting weapon select screen data
	if(screen == WeaponSelectScreen) {
		menu[Minimum] = 0;
		menu[Maximum] = 3;
		state[MenuProfile] = state[CurrentProfile];
		
		// Update the menu data
		for(i = 0; i < 2; i++) {
			menu[MenuCategory + i] = weapon[Category + i];
			menu[MenuWeapon + i] = weapon[Weapon + i];
		}
	}
}

// Checks if a button is held for an extended period of time
function CheckHeldButton(target, dynamic) {
	// Check if the target is held
	if(get_ival(target)) {
		// Check if no button is blocked
		if(state[ButtonBlock] == -1) {
			state[ButtonBlock] = target;
		}
		
		// Do nothing if a button is already blocked
		if(state[ButtonBlock] != target) {
			return FALSE;
		}
		
		// Check for initial press
		if(event_press(target)) {
			return TRUE;
		}
		
		// Check for dynamic adjustment
		if(dynamic) {
			// Check if button is held for 200ms or more
			if(get_ptime(target) >= 200) {
                if (get_ptime(target) > 4000)  {
                    // For every 10ms button is held after 2000ms, cycle value
                    state[ButtonHoldTime] = CheckHeldButtonTime(10);
                } else if (get_ptime(target) > 3000) {
                    // For every 30ms button is held after 2000ms, cycle value
                    state[ButtonHoldTime] = CheckHeldButtonTime(30);
                } else if (get_ptime(target) > 2000) {
                    // For every 50ms button is held after 2000ms, cycle value
                    state[ButtonHoldTime] = CheckHeldButtonTime(50);
                } else if (get_ptime(button) > 1000) {
                    // For every 70ms button is held after 1000ms, cycle value
                    state[ButtonHoldTime] = CheckHeldButtonTime(70);
                } else {
                    // For every 90ms button is held after initial 200ms, cycle value
                    state[ButtonHoldTime] = CheckHeldButtonTime(90);
                }
			} else {
				return FALSE;
			}
		} else {
			// Reset button hold time every 200ms
			state[ButtonHoldTime] = iif(state[ButtonHoldTime] >= 200, 0, state[ButtonHoldTime] + 10);
		}
		
		return !state[ButtonHoldTime];
		
	// Check if the held button has been released
	} else if(event_release(state[ButtonBlock])) {
		ResetButtonBlock();
	}
	
	// Indicate the button is not held
	return FALSE;
}

// Checks a button held time
function CheckHeldButtonTime(time) {
	return iif(state[ButtonHoldTime] >= time, 0, state[ButtonHoldTime] + 10);
}

// Checks for the screen saver
function CheckScreenSaver() {
	// Only allow screen saver on home screen
	if(state[Screen] != HomeScreen) {
		return FALSE;
	}
	
	// Check if the screen saver should engage
	if(state[ScreenSaver] >= 4000) {
		// Clear the screen
		cls_oled(OLED_BLACK);
		return TRUE;
	} else {
		state[ScreenSaver] += get_rtime();
	}
	
	// Indicate the screen saver has not engaged
	return FALSE;
}

// Corrects the stick input based on a drift value and deadzone
function CorrectStickInput(dz, stick) {
	// Calculate the boundaries
	antidrift[LowerBound] = (dz * -327);
	antidrift[UpperBound] = (dz * 327);
	antidrift[StickValue] = get_ival(stick);
	
	// Check for stick within boundaries
	if((antidrift[StickValue] >= antidrift[LowerBound]) && (antidrift[StickValue] <= antidrift[UpperBound])) {
		set_val(stick, 0);
		return;
	}
	
	// Determine the correction factor
	antidrift[CorrectionFactor] = (antidrift[StickValue] / 327);
	
	// Check for stick below lower boundary
	if(antidrift[StickValue] < antidrift[LowerBound]) {
		antidrift[StickValue] = (antidrift[StickValue] - antidrift[LowerBound]) - ((antidrift[CorrectionFactor] * antidrift[LowerBound]) / 100);
		set_val(stick, clamp(antidrift[StickValue], -32768, 32767));
		return;
	}
	
	// Check for stick above upper boundary
	if(antidrift[StickValue] > antidrift[UpperBound]) {
		antidrift[StickValue] = (antidrift[StickValue] - antidrift[UpperBound]) + ((antidrift[CorrectionFactor] * antidrift[UpperBound]) / 100);
		set_val(stick, clamp(antidrift[StickValue], -32768, 32767));
		return;
	}
}

// Cycles a menu page and updates its data
function CyclePage(adjustment) {
	menu[Page] = AdjustValue(menu[Page], 0, (sizeof(_scriptMenuData) / sizeof(_scriptMenuData[0])) - 1, adjustment, TRUE);
	menu[Minimum] = _scriptMenuData[menu[Page]][0];
	menu[Maximum] = _scriptMenuData[menu[Page]][1];
	menu[Type] = _scriptMenuData[menu[Page]][2];
}

// Cycles the weapon select pages
function CyclePageWeaponCategory(category, adjustment) {
	// Move to the next page
	menu[category] = AdjustValue(menu[category], 0, 3, adjustment, TRUE); 
	
	// Check if going back to the category with the selected weapon
	if(menu[category] == weapon[Category + state[MenuProfile]]) {
		menu[MenuWeapon + state[MenuProfile]] = weapon[Weapon + state[MenuProfile]];
	} else {
		menu[MenuWeapon + state[MenuProfile]] = 0; // Reset the currently selected weapon
	}
}

// Cycles a setting value given an adjustment
function CycleValue(adjustment, setting) {
	settings[setting + GetProfileAdjustment()] = AdjustValue(settings[setting + GetProfileAdjustment()], menu[Minimum], menu[Maximum], adjustment, iif(menu[Type] & Setting_String, TRUE, FALSE));
}

// Cycles the weapon selection
function CycleValueWeaponSelection(selection, adjustment) {
	menu[selection] = AdjustValue(menu[selection], 0, _weaponSelectData[menu[MenuCategory + state[MenuProfile]]], adjustment, TRUE);
}

// Draws a separator from the screen title
function DrawSeparator() {
	// Draw separator
	line_oled(0, 16, OLED_WIDTH - 1, 16, 1, OLED_WHITE);
}

// Draws a setting based on the type
function DrawSetting(setting) {
	// Determine the setting type
	switch(menu[Type] & ~Setting_Profile) {
		case Setting_Number {
			PrintNumber(AlignCenter, 28, OLED_FONT_MEDIUM, OLED_WHITE, setting);
			break;		
		}
		case Setting_Boolean {
			PrintString(AlignCenter, 28, OLED_FONT_MEDIUM, OLED_WHITE, _booleanStrings[setting]);
			break;
		}
		case Setting_String {
			PrintString(AlignCenter, 35, OLED_FONT_SMALL, OLED_WHITE, GetString(setting));
			break;
		}
		case Setting_Timer {
			InsertNumber(setting * VM_SPEED);
			InsertCharacter(ASCII_LOWER_M);
			InsertCharacter(ASCII_LOWER_S);
			FlushBuffer(AlignCenter, 28, OLED_FONT_MEDIUM, OLED_WHITE);
			break;
		}
	}
	
	// Check for profile specific setting
	if(menu[Type] & Setting_Profile) {
		PrintNumber(AlignRight, AlignTop, OLED_FONT_SMALL, OLED_WHITE, state[MenuProfile] + 1);
	}
}

// Draws a single line in the weapon selection screen
function DrawWeapon(y, size, index, str_addr) {
	// Check for current weapon
	if((menu[MenuCategory + state[MenuProfile]] == weapon[Category + state[MenuProfile]]) && (index == weapon[Weapon + state[MenuProfile]])) {
		InsertCharacter(OLED_RIGHT);
	}
	
	if((index == settings[DefaultWeapon + state[MenuProfile]]) && (menu[MenuCategory + state[MenuProfile]] == settings[DefaultCategory + state[MenuProfile]])) {
		InsertCharacter(ASCII_LEFT_BRACKET);
		InsertString(str_addr);
		InsertCharacter(ASCII_RIGHT_BRACKET):
	} else {
		InsertString(str_addr);
	}
	
	// Flush the buffer
	FlushBuffer(AlignCenter, y, size, OLED_WHITE);
}

// Draws a weapon to the weapon select screen
function DrawWeapons(current) {
	// Determine the weapon category selected
	switch(menu[MenuCategory + state[MenuProfile]]) {
		case AR {
			DrawWeapon(19, OLED_FONT_SMALL, iif(!current, _weaponSelectData[AR], current - 1), _arStrings[iif(!current, _weaponSelectData[AR], current - 1)]);
			DrawWeapon(30, OLED_FONT_MEDIUM, current, _arStrings[current]);
			DrawWeapon(51, OLED_FONT_SMALL, iif(current == _weaponSelectData[AR], 0, current + 1), _arStrings[iif(current == _weaponSelectData[AR], 0, current + 1)]);
			return;
		}
		case SMG {
			DrawWeapon(19, OLED_FONT_SMALL, iif(!current, _weaponSelectData[SMG], current - 1), _smgStrings[iif(!current, _weaponSelectData[SMG], current - 1)]);
			DrawWeapon(30, OLED_FONT_MEDIUM, current, _smgStrings[current]);
			DrawWeapon(51, OLED_FONT_SMALL, iif(current == _weaponSelectData[SMG], 0, current + 1), _smgStrings[iif(current == _weaponSelectData[SMG], 0, current + 1)]);
			return;
		}
		case LMG {
			DrawWeapon(19, OLED_FONT_SMALL, iif(!current, _weaponSelectData[LMG], current - 1), _lmgStrings[iif(!current, _weaponSelectData[LMG], current - 1)]);
			DrawWeapon(30, OLED_FONT_MEDIUM, current, _lmgStrings[current]);
			DrawWeapon(51, OLED_FONT_SMALL, iif(current == _weaponSelectData[LMG], 0, current + 1), _lmgStrings[iif(current == _weaponSelectData[LMG], 0, current + 1)]);
			return;
		}
		case Other {
			DrawWeapon(19, OLED_FONT_SMALL, iif(!current, _weaponSelectData[Other], current - 1), _otherStrings[iif(!current, _weaponSelectData[Other], current - 1)]);
			DrawWeapon(30, OLED_FONT_MEDIUM, current, _otherStrings[current]);
			DrawWeapon(51, OLED_FONT_SMALL, iif(current == _weaponSelectData[Other], 0, current + 1), _otherStrings[iif(current == _weaponSelectData[Other], 0, current + 1)]);
			return;
		}
	}
}

// Draws a weapon category in the weapon select screen
function DrawWeaponCategory(i, x, chars) {
	// Check for highlighting the category
	if(menu[MenuCategory + state[MenuProfile]] == i) {
		rect_oled(x - 3, 2, 5 + (chars * OLED_FONT_SMALL_WIDTH), OLED_FONT_SMALL_HEIGHT + 3, TRUE, OLED_WHITE);
	}
	
	// Print the weapon category name
	PrintString(x, AlignTop, OLED_FONT_SMALL, iif(menu[MenuCategory + state[MenuProfile]] == i, OLED_BLACK, OLED_WHITE), addr(_weaponSelectStrings[i]));
}

// Executes aim assist
function ExecuteAimAssist() {
    // Do nothing if aim assist is not enabled OR ADS is not held
    if(!settings[TrackingAssist + state[CurrentProfile]] || !state[HoldingADS]) {
        aimassist[AimAngle] = 0;
        return;
    }
    
    // Retrieve base values
    aimassist[AimRadius] = settings[TrackingSize + state[CurrentProfile]];
    aimassist[AimSpeed] = settings[TrackingSpeed + state[CurrentProfile]];

    // Check for boost on ADS & Fire
    if(state[HoldingFire] && settings[BoostAssist + state[CurrentProfile]]) {
        aimassist[AimRadius] = clamp(aimassist[AimRadius] + settings[BoostSize + state[CurrentProfile]], 0, 100);
        aimassist[AimSpeed] = clamp(aimassist[AimSpeed] + settings[BoostSpeed + state[CurrentProfile]], 1, 200);
    }
    
    // Output the aim assist
    OutputAimAssist();
}


// Engages the anti-recoil
function ExecuteAntiRecoil() {
	// Check if the user is actually firing
	if(!state[HoldingADS] || !state[HoldingFire]) {
		antirecoil[CurrentStep] = -1;
		return;
	}

	// Determine which anti-recoil to work on
	if(state[CurrentProfile] == GroundLoot) {
		ExecuteAntiRecoilBasic();
		return; // Prevent horizontal from being applied
	} else {
		// Execute the anti-recoil
		ExecuteAntiRecoilWeapon();
	}
	
	// Perform adjustments
	OutputAntiRecoil(antirecoil[X], antirecoil[Y]);
}

// Outputs the ground loot basic anti-recoil
function ExecuteAntiRecoilBasic() {
	OutputAntiRecoil(0, settings[Vertical] * 328);
}

// Outputs the loadout, weapon specific anti-recoil
function ExecuteAntiRecoilWeapon() {
	// Check if fire is first being pressed
	if(event_press(button[Fire])) {
		InitializeAntiRecoil();
	}
	
	// Do nothing if there are no steps
	if((!antirecoil[StepCount] || (antirecoil[CurrentStep] >= (antirecoil[StepCount] - 1)))) {
		antirecoil[X] = 0; // Prevent unwanted output
		antirecoil[Y] = 0; // Prevent unwanted output
		return;
	}
	
	// Check if there are steps left
	if(antirecoil[CurrentStepTime] < antirecoil[StepTime]) {
		antirecoil[X] += antirecoil[X_Change];
		antirecoil[Y] += antirecoil[Y_Change];
		antirecoil[CurrentStepTime] += get_rtime();
	} else {
		antirecoil[CurrentStep]++; // Advance to the next step
		antirecoil[CurrentStepTime] = 0; // Reset the step time
		CalculateStepChangeValues(); // Calculate new change values
	}
	
	set_val(TRACE_6, antirecoil[CurrentStep]);
}

// Executes Bunny Hop
function ExecuteBunnyHop() {
	// Check if Bunny Hop is enabled
	if(settings[BunnyHop]) {
		// Check if the Jump button is being held
		if(get_ival(button[Jump])) {
			combo_run(Combo_BunnyHop);
			return TRUE;
		}
	}
	
	return FALSE;
}

// Executes deadzones
function ExecuteDeadzone(left, right) {
	// Correct the stick input for the left joystick based on only the deadzone
	if(left) {
		CorrectStickInput(left, POLAR_LY);
		CorrectStickInput(left, POLAR_LX);
	}
	
	// Correct the stick input for the right joystick based on only the deadzone
	if(right) {
		CorrectStickInput(right, POLAR_RY);
		CorrectStickInput(right, POLAR_RX);
	}
}

// Executes any movement mods
function ExecuteMovement() {
	// Retrieves the strafe stick
	GetStrafeStick();
	
	// First check for mods that don't require nearly full stick movement
	if(ExecuteBunnyHop() || ExecuteYY()) {
		return TRUE;
	}

	// The strafe stick must be 97% or more for slide/dive behavior
	if(state[PolarRadius] >= 9700) {
		if(ExecuteSlideCancel()) {
			return TRUE; // Perform any slide/dive behaviors
		}
	}
	
	return FALSE;
}

// Executes Ping On Fire
function ExecutePingOnFire() {
	// Check if Auto Ping is enabled
	if(settings[PingOnFire + state[CurrentProfile]]) {
		// Engage when:
		// - Holding ADS + pressing fire
		if(state[HoldingADS] && event_press(button[Fire])) {
			combo_run(Combo_PingOnFire);		
		}
	}
}

// Executes profile switching
function ExecuteProfiles() {
	// Check if the resync button is being held
	if(get_ival(button[ADS])) {
		if(event_press(button[SwitchWeapon])) {
			if(state[CurrentProfile] != GroundLoot) {
				ChangeProfile(!state[CurrentProfile]);
			}
		} else if(event_press(XB1_RIGHT)) {
			ChangeProfile(GroundLoot);
		}
	} else if(event_release(button[SwitchWeapon]) && (get_ptime(button[SwitchWeapon]) <= 240) && (state[CurrentProfile] != GroundLoot)) {
		ChangeProfile(!state[CurrentProfile]);
	} 
}

// Executes slide cancel
function ExecuteSlideCancel() {
	// Check for slide cancel
	if(settings[SlideCancel] && (event_release(button[Action]) && (get_ptime(button[Action]) < 176))) {
		combo_run(Combo_SlideCancel);
		return TRUE;
	}
	
	return FALSE;
}

// Executes Sniper Mode
function ExecuteSniperMode() {
	// Check if Sniper Mode is enabled
	if(settings[SniperMode + state[CurrentProfile]]) {
		if(state[HoldingADS]) {
			combo_run(Combo_SniperMode);
		} else {
			combo_stop(Combo_SniperMode);	
		}
	}
}

// Executes the strafe assist
function ExecuteStrafeAssist() {
	// Do nothing if strafe assist is not enabled
	if(!settings[StrafeAssist + state[CurrentProfile]]) {
		return;
	}
	
	// Do nothing if not firing and no rumble detected
	if(!state[HoldingFire] || (antirecoil[CurrentStep] == -1)) {
		combo_stop(Combo_StrafeAssist);
		return;
	}
	
	// Execute the strafe assist combo
	if(state[HoldingFire]) {
		state[StrafeComboSize] = CalculatePercentage(settings[StrafeSize + state[CurrentProfile]], (iif(get_ptime(button[Fire]) >= 200, 200, get_ptime(button[Fire])) * 100) / 200) * 328;
	}
	
	combo_run(Combo_StrafeAssist);
}

// Executes the YY spam
function ExecuteYY() {
	// Check if YY is enabled, the user is not holding ADS or Fire and holding the Sprint button
	if(settings[YY] && !state[HoldingADS] && !state[HoldingFire] && get_ival(stick[SprintButton])) {
		combo_run(Combo_YY);
		return TRUE;
	}
	
	return FALSE;
}

// Flushes the diplay buffer
function FlushBuffer(x, y, size, color) {
	// Prepare buffer for rendering
	display[Buffer]--;
	
	// Calculate horizontal position
	if(x == AlignRight) {
		x = OLED_WIDTH - (display[Buffer] * _fontWidth[size]) - 3; // Additional 2 for padding from border
	} else if(x == AlignCenter) {
		x = (OLED_WIDTH >> 1) - ((display[Buffer] * _fontWidth[size]) >> 1);
	}
	
	// Calculate vertical position
	if(y == AlignBottom) {
		y = OLED_HEIGHT - _fontHeight[size] - 2; // Additional 2 for padding from border
	} else if(y == AlignCenter) {
		y = (OLED_HEIGHT >> 1) - (_fontHeight[size] >> 1);
	}
	
	// Output to display
	puts_oled(clamp(x, 2, 127), clamp(y, 2, 63), size, display[Buffer], color);
	
	// Reset buffer position
	display[Buffer] = 1;	
}

// Retrieves controller data
function GetControllerData() {
	// Retrieve ADS and Firing states
	state[HoldingADS] = get_ival(button[ADS]);
	state[HoldingFire] = get_ival(button[Fire]);
	
	// Retrieve rumble state
	rumble = get_rumble(RUMBLE_A) + get_rumble(RUMBLE_B);
}

// Returns the adjustment based on profile used in the menu
function GetProfileAdjustment() {
	// Determine which page is showing
	switch(menu[Page]) {
		case TrackingAssistEdit { return state[MenuProfile]; }
		case TrackingSizeEdit { return 2 + state[MenuProfile]; }
		case TrackingSpeedEdit { return 4 + state[MenuProfile]; }
		case BoostAssistEdit { return 6 + state[MenuProfile]; }
		case BoostSizeEdit { return 8 + state[MenuProfile]; }
		case BoostSpeedEdit { return 10 + state[MenuProfile]; }
		case StrafeAssistEdit { return 12 + state[MenuProfile]; }
		case StrafeSizeEdit { return 14 + state[MenuProfile]; }
		case StrafeSpeedEdit { return 16 + state[MenuProfile]; }
		case BlockVibrationEdit { return 18; }
		case FlippedEdit { return 18; }
		case InvertedEdit { return 18; }
		case DeadzoneLeftEdit { return 18; }
		case DeadzoneRightEdit { return 18; }
		case BunnyHopEdit { return 18; }
		case PingOnFireEdit { return 18 + state[MenuProfile]; }
		case SniperModeEdit { return 20 + state[MenuProfile]; }
		case SlideCancelEdit { return 22; }
		case YYEdit { return 22; }
	}
	
	return 0;
}

// Returns the string to use for profile display
function GetProfileString() {
	return _profileStrings[state[CurrentProfile]];
}

// Retrives the strafe stick based on the user's stick layout and joystick movement
function GetStrafeStick() {
	// Determine the stick layout
	switch(settings[StickLayout]) {
		case Default {
			stick[SprintButton] = XB1_LS;
			break;
		} case Southpaw {
			stick[SprintButton] = XB1_RS;
			break;
		} case Legacy {
			stick[SprintButton] = iif(abs(get_val(POLAR_RY)) > abs(get_val(POLAR_LX)), XB1_LS, XB1_RS);
			break;
		} case LegacySouthpaw {
			stick[SprintButton] = iif(abs(get_val(POLAR_LY)) > abs(get_val(POLAR_RX)), XB1_RS, XB1_LS);
			break;
		} case SouthpawNoClickSwap {
			stick[SprintButton] = XB1_RS;
			break;
		} case LegacySouthpawNoClickSwap {
			stick[SprintButton] = iif(abs(get_val(POLAR_LY)) > abs(get_val(POLAR_RX)), XB1_RS, XB1_LS);
			break;
		}
	}
	
	// Set the polar move stick
	state[PolarRadius] = get_polar(iif(stick[SprintButton] == XB1_LS, POLAR_LS, POLAR_RS), POLAR_RADIUS);
}

// Returns a string based on the current page
function GetString(page) {
	// Determine which string to return
	switch(menu[Page]) {
		case ButtonLayout {
			return _buttonLayoutStrings[page];
		}
		case StickLayout {
			return _stickLayoutStrings[page];
		}
	}
	
	return 0;
}

// Returns the weapon name based on the category
function GetWeaponName(id) {
	// Determine the weapon category
	switch(weapon[Category + state[CurrentProfile]]) {
		case AR {
			return _arStrings[id];		
		}
		case SMG {
			return _smgStrings[id];		
		}
		case LMG {
			return _lmgStrings[id];		
		}
	}
	
	return _otherStrings[id];	
}

// Handles any device input
function HandleDeviceInput() {
	// Retrieve controller data
	GetControllerData();
	
	// Dispatch the input handler
	switch(state[Screen]) {
		case HomeScreen {
			ProcessHomeScreen();
			return;
		}
		case MenuScreen {
			ProcessMenuScreen();
			return;
		}
		case GroundLootScreen {
			ProcessGroundLootScreen();
			return;
		}
		case WeaponSelectScreen {
			ProcessWeaponSelectScreen();
			return;
		}
		case WeaponSelectRecoilScreen {
			ProcessWeaponSelectRecoilScreen();
			return;
		}
	}
}

// Handles any device output
function HandleDeviceOutput() {
	// Check for blocking all inputs
	if(state[Screen] != HomeScreen) {
		block_all_inputs();
	}
	// Check for blocking actions on home screen
	else if(state[HoldingADS]) {
		set_val(XB1_LEFT, 0);	// Block barrel
		set_val(XB1_DOWN, 0);	// Block scope
		set_val(XB1_RIGHT, 0);	// Block ground loot
		set_val(XB1_MENU, 0);	// Block menu
		set_val(XB1_VIEW, 0);	// Block weapon select
		set_val(XB1_Y, 0);		// Block weapon switch
	}
	
	// Check for button block
	if(get_ival(state[ButtonBlock])) {
		set_val(state[ButtonBlock], 0);
	}
	// Check for button block release
	else if(event_release(state[ButtonBlock])) {
		state[ButtonBlock] = -1;
	}
}

// Handles any display updates
function HandleDisplayUpdate() {
	// Check if a display update is needed
	if(CheckScreenSaver() || !display[Update]) {
		return;
	}
	
	// Clear the screen
	cls_oled(OLED_BLACK);
	
	// Draw a border
	rect_oled(0, 0, OLED_WIDTH, OLED_HEIGHT, 0, OLED_WHITE);
	
	// Determine how the screen should render
	switch(state[Screen]) {
		case HomeScreen {
			RenderHomeScreen();
			break;
		}
		case MenuScreen {
			RenderMenuScreen();
			break;
		}
		case GroundLootScreen {
			RenderGroundLootScreen();
			break;
		}
		case WeaponSelectScreen {
			RenderWeaponSelectScreen();
			break;
		}
		case WeaponSelectRecoilScreen {
			RenderWeaponSelectRecoilScreen();
			break;
		}
	}
	
	// Indicate the display has been updated
	display[Update] = FALSE;
}

// Handles any LED updates
function HandleLedUpdate() {
	// Check if a LED update is needed
	if(!display[UpdateLed] || combo_running(Combo_LedAlert)) {
		return;
	}
	
	// Determine how the LED should update
	switch(state[Screen]) {
		case HomeScreen {
			SetLedColor(state[CurrentProfile]);
			break;	
		}
		case MenuScreen {
			if(menu[Type] & Setting_Profile) {
				SetLedColor(state[MenuProfile]); // Set profile's LED color
			} else {
				SetLedColor(MenuPurple); // Set menu LED color
			}
			break;
		}
		case WeaponSelectScreen {
			SetLedColor(state[MenuProfile]);
			break;
		}
		case WeaponSelectRecoilScreen {
			SetLedColor(state[MenuProfile]);
			break;
		}
	}
	
	// Indicate the LED has been updated
	display[UpdateLed] = FALSE;
}

// Ternary operator replacement
function iif(expression, true_part, false_part) {
	// Evaluate expression
	if(expression) {
		return true_part; // Return true
	}
	
	// Return false
	return false_part;
}

function InitializeAntiRecoil() {
	// Initialize anti-recoil data
	antirecoil[CurrentStep] = 0;
	antirecoil[CurrentStepTime] = 0;
	
	// Determine which weapon data to read
	switch(weapon[Category + state[CurrentProfile]]) {
		case AR {
			antirecoil[StartPosition] = _arRecoilDataStart[weapon[Weapon + state[CurrentProfile]]];
			antirecoil[StepTime] = _arRecoilData[antirecoil[StartPosition]];
			antirecoil[StepCount] = _arRecoilData[antirecoil[StartPosition] + 1];
			antirecoil[RecoilStartPosition] = antirecoil[StartPosition] + 2;
			antirecoil[X] = _arRecoilData[antirecoil[RecoilStartPosition] + antirecoil[StepCount]] * 328;
			antirecoil[Y] = _arRecoilData[antirecoil[RecoilStartPosition]] * 328;
			break;	
		}
		case SMG {
			antirecoil[StartPosition] = _smgRecoilDataStart[weapon[Weapon + state[CurrentProfile]]];
			antirecoil[StepTime] = _smgRecoilData[antirecoil[StartPosition]];
			antirecoil[StepCount] = _smgRecoilData[antirecoil[StartPosition] + 1];
			antirecoil[RecoilStartPosition] = antirecoil[StartPosition] + 2;
			antirecoil[X] = _smgRecoilData[antirecoil[RecoilStartPosition] + antirecoil[StepCount]] * 328;
			antirecoil[Y] = _smgRecoilData[antirecoil[RecoilStartPosition]] * 328;
			break;
		}
		case LMG {
			antirecoil[StartPosition] = _lmgRecoilDataStart[weapon[Weapon + state[CurrentProfile]]];
			antirecoil[StepTime] = _lmgRecoilData[antirecoil[StartPosition]];
			antirecoil[StepCount] = _lmgRecoilData[antirecoil[StartPosition] + 1];
			antirecoil[RecoilStartPosition] = antirecoil[StartPosition] + 2;
			antirecoil[X] = _lmgRecoilData[antirecoil[RecoilStartPosition] + antirecoil[StepCount]] * 328;
			antirecoil[Y] = _lmgRecoilData[antirecoil[RecoilStartPosition]] * 328;
			break;
		}
		case Other {
			antirecoil[StartPosition] = _otherRecoilDataStart[weapon[Weapon + state[CurrentProfile]]];
			antirecoil[StepTime] = _otherRecoilData[antirecoil[StartPosition]];
			antirecoil[StepCount] = _otherRecoilData[antirecoil[StartPosition] + 1];
			antirecoil[RecoilStartPosition] = antirecoil[StartPosition] + 2;
			antirecoil[X] = _otherRecoilData[antirecoil[RecoilStartPosition] + antirecoil[StepCount]] * 328;
			antirecoil[Y] = _otherRecoilData[antirecoil[RecoilStartPosition]] * 328;
			
			set_val(TRACE_5, antirecoil[StartPosition]);
			break;
		}
	}
	
	CalculateStepChangeValues(); // Calculate the step change values
	DrawProfile(); // Draw profile name
	
	set_val(TRACE_1, antirecoil[StepTime]);
	set_val(TRACE_2, antirecoil[StepCount]);
}

// Inserts a character to the display buffer
function InsertCharacter(value) {
	putc_oled(display[Buffer], value); // Store the character
	display[Buffer]++; // Advance to the next position
}

// Inserts a number to the display buffer
function InsertNumber(value) {
	// Handle negatives
	if(value < 0) {
		InsertCharacter(ASCII_MINUS);	// Insert '-' into the display buffer
		value = abs(value);
	}
	
	display[BufferCopyValue] = value;
	display[BufferDigitCount] = 0;
	
    // Count digits
    do {
        display[BufferCopyValue] /= 10;
        display[BufferDigitCount]++;
    } while(display[BufferCopyValue]);
    
    // Extract digits
    for(i = 0; i < display[BufferDigitCount]; i++) {
        display[BufferDigits + i] = (value % 10) + 48;
        value /= 10;
    }
    
   // Insert digits in correct order
    for(i = display[BufferDigitCount] - 1; i >= 0; i--) {
        InsertCharacter(display[BufferDigits + i]);
    }
}

// Inserts a string to the display buffer
function InsertString(str) {
	do {
		InsertCharacter(dint8(str)); 	// Insert the current character
		str++; 							// Advance to the next character in the string
	} while(dint8(str));
}

// This function triggers an led alert
function LedAlert(color) {
	// Indicate the display should update
	display[Update] = TRUE;
	
	// Set the new LED color
	SetLedColor(color);
	
	// Execute the LED alert combo
	combo_restart(Combo_LedAlert);
}

// Outputs a value to a stick
function Output(stick, value) {
	set_val(stick, clamp(value * (32767 - abs(get_val(stick))) / 32767 + get_val(stick), -32768, 32767));
}

// Outputs aim assist
function OutputAimAssist() {
	// Determine coordinates
	aimassist[X] = cos[aimassist[AimAngle]] * aimassist[AimRadius]
	aimassist[Y] = sin[aimassist[AimAngle]] * aimassist[AimRadius];
	
	// Advance the angle
	aimassist[AimAngle] = (aimassist[AimAngle] + aimassist[AimSpeed]) % 360;

	// Output stick values
	Output(stick[Rotate], aimassist[X]);
	Output(stick[Look], aimassist[Y]);
}

// Outputs anti-recoil
function OutputAntiRecoil(x, y) {
	// Check for hip-fire adjustment
	if(!state[HoldingADS]) {
		x = CalculatePercentage(x, 70);
		y = CalculatePercentage(y, 70);
	}
	
	// Perform any adjustment
	if(state[CurrentProfile] != GroundLoot) {
		x = CalculatePercentage(x, 100 + settings[HorizontalValue + state[CurrentProfile]]);
		y = CalculatePercentage(y, 100 + settings[VerticalValue + state[CurrentProfile]]);
	}
	
	// Output the values with inverted check
	Output(stick[Rotate], x);
	Output(stick[Look], y * iif(settings[Inverted], -1, 1));
}

// Prints a number at the provided coordinates
function PrintNumber(x, y, size, color, value) {
	InsertNumber(value);
	FlushBuffer(x, y, size, color);
}

// Prints a string at the provided coordinates
function PrintString(x, y, size, color, text) {
	InsertString(text);
	FlushBuffer(x, y, size, color);
}

// Processes any ground loot screen input
function ProcessGroundLootScreen() {
	// Check if user is exiting the screen
	if(event_press(XB1_B)) {
		SettingsSave();
	}
	// Check for user increasing the value
	else if(CheckHeldButton(XB1_UP, TRUE)) {
		settings[Vertical] = AdjustValue(settings[Vertical], 0, 100, 1, FALSE);
	}
	// Check for user decreasing the value
	else if(CheckHeldButton(XB1_DOWN, TRUE)) {
		settings[Vertical] = AdjustValue(settings[Vertical], 0, 100, -1, FALSE);
	}
}

// Processes any home screen input
function ProcessHomeScreen() {
	// Check if user is performing an action
	if(state[HoldingADS]) {
		// Check if user is entering script menu
		if(event_press(XB1_MENU)) {
			state[MenuProfile] = state[CurrentProfile]; // Set the menu profile
			ChangeScreen(MenuScreen); // Enter menu screen
			return;
		}
		
		// Check if user is entering ground loot vertical screen
		if(event_press(XB1_VIEW) && state[CurrentProfile] == GroundLoot) {
			ChangeScreen(GroundLootScreen);
			return;
		}
		
		// Make sure only primary/secondary can enter weapon selection
		if(state[CurrentProfile] != GroundLoot) {
			// Check for user entering weapon select recoil screen
			if(get_ival(XB1_VIEW) && get_ptime(XB1_VIEW) >= 1000) {
				menu[Page] = 0; // Revert back to vertical
				ChangeScreen(WeaponSelectRecoilScreen);
				state[MenuProfile] = state[CurrentProfile]; // Set current menu profile
				return;
			}
			
			// Check if user is entering weapon selection screen
			if(event_release(XB1_VIEW)) {
				ChangeScreen(WeaponSelectScreen);
				state[MenuProfile] = state[CurrentProfile]; // Set current menu profile
				return;
			}
		}
		
		// Check if user is toggling ground loot
		if(event_press(XB1_RIGHT)) {
			ChangeProfile(iif(state[CurrentProfile] == GroundLoot, Primary, GroundLoot));
			return;
		}
		
		// Only allow Primary/Secondary
		if(state[CurrentProfile] != GroundLoot) {
			// Check if user is resetting weapons/attachments
			if(get_ival(XB1_UP) && event_press(XB1_X) && (get_brtime(XB1_X) <= 240)) {
				// Reset weapons
				for(i = 0; i < 2; i++) {
					weapon[Category + i] = settings[DefaultCategory + i];
					weapon[Weapon + i] = settings[DefaultWeapon + i];
				}
				
				// Alert success
				LedAlert(MenuGreen);
			}
		}
	}
	
	// Check for switching profiles
	ExecuteProfiles();
	
	// The following can only execute if not holstered, paused or inventory
	if(!state[Stance]) {
		// Draw profile name anytime X is pressed
		if(event_press(button[Reload])) {
			DrawProfile();
		}
		
		// Apply deadzone
		ExecuteDeadzone(settings[DeadzoneLeft], settings[DeadzoneRight]);
		
		// If no movement mods, engage firing mods
		if(!ExecuteMovement()) {
			ExecuteAntiRecoil();
			ExecuteAimAssist();
			ExecutePingOnFire();
			ExecuteSniperMode();
			ExecuteStrafeAssist();
		}
	}
	
	// Set hair triggers
	deadzone(button[ADS], button[Fire], 100, 100);
}

// Processes any menu screen input
function ProcessMenuScreen() {
	// Check if user is exiting menu
	if(event_release(XB1_B)) {
		SettingsSave();
	}
	
	// Check for user advancing through the menu
	if(CheckHeldButton(XB1_RIGHT, FALSE)) {
		CyclePage(1);
	}
	// Check for user reversing through the menu
	else if(CheckHeldButton(XB1_LEFT, FALSE)) {
		CyclePage(-1)
	}
	// Check for user increasing the value
	else if(CheckHeldButton(XB1_UP, iif(menu[Type] & Setting_String, FALSE, TRUE))) {
		CycleValue(1, menu[Page]);
	}
	// Check for user decreasing the value
	else if(CheckHeldButton(XB1_DOWN, iif(menu[Type] & Setting_String, FALSE, TRUE))) {
		CycleValue(-1, menu[Page]);
	}
	
	// Check if user is switching profiles
	else if((menu[Type] & Setting_Profile) && event_press(XB1_Y)) {
		state[MenuProfile] = (state[MenuProfile] + 1) % 3;
		display[Update] = TRUE;
		SetMenuItemInformation();
	}
}

// Processes any weapon selection screen input
function ProcessWeaponSelectScreen() {
	// Check if the user is exiting the menu
	if(event_release(XB1_B)) {
		// Revert back to home screen
		SettingsSave();
		
	} else if(event_press(XB1_A)) {
		// Check for double-tapping to exit
		if(get_brtime(XB1_A) <= 250) {
			SettingsSave();
			state[ButtonBlock] = XB1_A;
		} else {
			// Set the weapon data
			weapon[Category + state[MenuProfile]] = menu[MenuCategory + state[MenuProfile]];
			weapon[Weapon + state[MenuProfile]] = menu[MenuWeapon + state[MenuProfile]];
			
			// Alert the user the weapon was set
			LedAlert(MenuGreen);
		}
	} else if(event_press(XB1_RIGHT) || event_press(XB1_RB)) {
		// Advance to the next category
		CyclePageWeaponCategory(MenuCategory + state[MenuProfile], 1);
	} else if(event_press(XB1_LEFT) || event_press(XB1_LB)) {
		// Reverse to previous category
		CyclePageWeaponCategory(MenuCategory + state[MenuProfile], -1);
	} else if(CheckHeldButton(XB1_DOWN, FALSE)) {
		// Advance to the next weapon
		CycleValueWeaponSelection(MenuWeapon + state[MenuProfile], 1);
	} else if(CheckHeldButton(XB1_UP, FALSE)) {
		// Reverse to the previous weapon
		CycleValueWeaponSelection(MenuWeapon + state[MenuProfile], -1);
	} else if(event_press(XB1_Y)) {
		// Change menu profile and update the display
		state[MenuProfile] = !state[MenuProfile];
		menu[MenuCategory + state[MenuProfile]] = weapon[Category + state[MenuProfile]];
		menu[MenuWeapon + state[MenuProfile]] = weapon[Weapon + state[MenuProfile]];
		ResetDisplay(TRUE);
	} else if(event_press(XB1_VIEW)) {
		// Check for setting default weapon
		settings[DefaultCategory + state[MenuProfile]] = menu[MenuCategory + state[MenuProfile]];
		settings[DefaultWeapon + state[MenuProfile]] = menu[MenuWeapon + state[MenuProfile]];
		LedAlert(MenuGreen);
	}
}

// Processes any weapon select recoil screen
function ProcessWeaponSelectRecoilScreen() {
	// Check if the user is exiting the menu
	if(event_release(XB1_B)) {
		// Revert back to home screen
		SettingsSave();
		return;
	}
	
	// Check for user switching profiles
	if(event_press(XB1_Y)) {
		state[MenuProfile] = !state[MenuProfile]; // Toggle which profile being edited
		ResetDisplay(TRUE); // Redraw the display
		return;
	}
	
	// Check for user switching pages
	if(event_press(XB1_LEFT) || event_press(XB1_RIGHT)) {
		menu[Page] = !menu[Page];
		ResetDisplay(TRUE); // Redraw the display
		return;
	}
	
	// Check for reducing values
	if(CheckHeldButton(XB1_DOWN, TRUE)) {
		AdjustRecoilValue(iif(menu[Page], HorizontalValue, VerticalValue) + state[MenuProfile], -1);
		return;
	}
	
	// Check for increasing values
	if(CheckHeldButton(XB1_UP, TRUE)) {
		AdjustRecoilValue(iif(menu[Page], HorizontalValue, VerticalValue) + state[MenuProfile], 1);
		return;
	}
}

// Renders the ground loot screen
function RenderGroundLootScreen() {
	// Print the page title with separator
	DrawSeparator();
	PrintString(AlignCenter, AlignTop, OLED_FONT_SMALL, OLED_WHITE, addr(_groundLootScreenStrings[0]));
	PrintNumber(AlignCenter, 28, OLED_FONT_LARGE, OLED_WHITE, settings[Vertical]);
}

// Renders the home screen
function RenderHomeScreen() {
	// Print author and title
	PrintString(AlignCenter, AlignTop, OLED_FONT_MEDIUM, OLED_WHITE, addr(_homeScreenStrings[Home_Author]));
	PrintString(AlignCenter, 28, OLED_FONT_MEDIUM, OLED_WHITE, addr(_homeScreenStrings[Home_Title]));
	
	// Prepare version display
	InsertString(addr(_homeScreenStrings[Home_Version]));
	InsertCharacter(ASCII_SPACE);
	InsertNumber(_scriptVersion[Major]);
	InsertCharacter(ASCII_PERIOD);
	
	// Build the minor version portion
	if(_scriptVersion[Minor] < 10) {
		InsertNumber(0);
	}
	InsertNumber(_scriptVersion[Minor]);
	
	// Flush the version information
	FlushBuffer(AlignCenter, AlignBottom, OLED_FONT_SMALL, OLED_WHITE);
}

// Renders the script menu
function RenderMenuScreen() {
	// Print the page title with separator
	DrawSeparator();
	DrawSetting(settings[menu[Page] + GetProfileAdjustment()]);
	PrintString(AlignCenter, AlignTop, OLED_FONT_SMALL, OLED_WHITE, _menuScreenStrings[menu[Page]]);
}

// Renders the weapon selection
function RenderWeaponSelectScreen() {
	// Draw separator
	DrawSeparator();
	
	// Print each weapon category
	DrawWeaponCategory(0, 5, 2);
	DrawWeaponCategory(1, 27, 3);
	DrawWeaponCategory(2, 56, 3);
	DrawWeaponCategory(3, 89, 5);
	
	// Print each weapon name
	DrawWeapons(menu[MenuWeapon + state[MenuProfile]]);
}

// Draws the recoil value to the screen
function DrawRecoilValue(value) {
	// Insert the value with a percent sign
	InsertNumber(100 + value);
	InsertCharacter(ASCII_PERCENT);
	FlushBuffer(AlignCenter, 28, OLED_FONT_MEDIUM, OLED_WHITE);
}

// Renders the weapon select recoil screen
function RenderWeaponSelectRecoilScreen() {
	// Draw separator
	DrawSeparator();
	
	// Print profile name
	PrintString(AlignCenter, AlignTop, OLED_FONT_SMALL, OLED_WHITE, _weaponSelectRecoilStrings[menu[Page]]);
	
	// Print profile number
	PrintNumber(AlignRight, AlignTop, OLED_FONT_SMALL, OLED_WHITE, state[MenuProfile] + 1);
	
	// Print recoil adjustment
	DrawRecoilValue(settings[iif(menu[Page], HorizontalValue, VerticalValue) + state[MenuProfile]]);
	
	return;
}

// Resets a blocked button
function ResetButtonBlock() {
	state[ButtonBlock] = -1;
	state[ButtonHoldTime] = 0;
}

// Resets the screen
function ResetDisplay(update) {
	state[ScreenSaver] = 0;
	display[Update] = update;
	display[UpdateLed] = TRUE;
}

// Resets the screen saver
function ResetScreenSaver() {
	state[ScreenSaver] = 0;
}

// Sets the Button Layout
function SetButtonLayout() {
	// Iterate through each button and set it
	for(i = ADS; i <= Melee; i++) {
		button[i] = _buttonLayout[settings[ButtonLayout]][i];
	}
}

// Sets flipped button layout
function SetFlippedButtons() {
	// Check if Flipped is enabled
	if(settings[Flipped]) {
		// Iterate through each button and set it
		for(i = ADS; i <= Melee; i++) {
			switch(button[i]) {
				case XB1_LT {
					button[i] = XB1_LB;	
					break;	
				}
				case XB1_LB {
					button[i] = XB1_LT;	
					break;	
				}
				case XB1_RT {
					button[i] = XB1_RB;	
					break;	
				}
				case XB1_RB {
					button[i] = XB1_RT;	
					break;	
				}
			}
		}
	}
}

// Sets the LED color
function SetLedColor(color) {
	set_hsb(_color[color][Hue], _color[color][Saturation], _color[color][Brightness]);
}

// Sets the current menu item information
function SetMenuItemInformation() {
	// Retrieve menu item information
	menu[Minimum] = _scriptMenuData[menu[Page]][0];
	menu[Maximum] = _scriptMenuData[menu[Page]][1];
	menu[Type] = _scriptMenuData[menu[Page]][2];
}

// Sets the Stick Layout
function SetStickLayout() {
	// Iterate through each stick direction and set it
	for(i = Move; i <= Rotate; i++) {
		stick[i] = _stickLayout[settings[StickLayout]][i];
	}
}

// Sets the vibration state
function SetVibrationState() {
	// Check how rumble should be handled
	if(settings[BlockVibration]) {
		block_rumble();	
	} else {
		reset_rumble();
	}
}

// Loads the settings
function SettingsLoad() {
	// Reset SPVAR state
	SpvarReset();
	
	// Check if any SPVAR data is available
	if(SpvarRead(0, 1)) {
		// Load user settings
		settings[ButtonLayout] = SpvarRead(Default, Beast);
		settings[StickLayout] = SpvarRead(Default, LegacySouthpawNoClickSwap);

		// Load profile-specific data
		for(i = 0; i < 3; i++) {
			settings[TrackingAssist + i] = SpvarRead(FALSE, TRUE);
			settings[TrackingSize + i] = SpvarRead(1, 100);
			settings[TrackingSpeed + i] = SpvarRead(1, 100);
			settings[BoostAssist + i] = SpvarRead(FALSE, TRUE);
			settings[BoostSize + i] = SpvarRead(-100, 100);
			settings[BoostSpeed + i] = SpvarRead(-100, 100);
			settings[StrafeAssist + i] = SpvarRead(FALSE, TRUE);
			settings[StrafeSize + i] = SpvarRead(1, 100);
			settings[StrafeSpeed + i] = SpvarRead(1, 125);
			settings[PingOnFire + i] = SpvarRead(FALSE, TRUE);
			settings[SniperMode + i] = SpvarRead(FALSE, TRUE);
		}
		
		// Load weapon data
		for(i = 0; i < 2; i++) {
			settings[HorizontalValue + i] = SpvarRead(-100, 100);
			settings[VerticalValue + i] = SpvarRead(-100, 100);
		}
		
		settings[BlockVibration] = SpvarRead(FALSE, TRUE);
		settings[BunnyHop] = SpvarRead(FALSE, TRUE);
		settings[Flipped] = SpvarRead(FALSE, TRUE);
		settings[Inverted] = SpvarRead(FALSE, TRUE);
		settings[DeadzoneLeft] = SpvarRead(0, 25);
		settings[DeadzoneRight] = SpvarRead(0, 25);
		settings[SlideCancel] = SpvarRead(FALSE, TRUE);
		settings[Vertical] = SpvarRead(0, 100);
		settings[YY] = SpvarRead(FALSE, TRUE);
		
		// Load default weapon data
		for(i = 0; i < 2; i++) {
			settings[DefaultCategory + i] = SpvarRead(AR, Other);
			settings[DefaultWeapon + i] = SpvarRead(0, 20);
			
			// Set default weapon and category
			weapon[Category + i] = settings[DefaultCategory + i];
			weapon[Weapon + i] = settings[DefaultWeapon + i];
		}

	
	} else {
		// Set Default settings
		settings[ButtonLayout] = Default;
		settings[StickLayout] = Default;
		
		// Load aim assist
		for(i = 0; i < 3; i++) {
			settings[TrackingAssist + i] = TRUE;
			settings[TrackingSize + i] = 9;
			settings[TrackingSpeed + i] = 19;
			settings[BoostAssist + i] = TRUE;
			settings[BoostSize + i] = 11;
			settings[BoostSpeed + i] = 4;
			settings[StrafeAssist + i] = TRUE;
			settings[StrafeSize + i] = 30;
			settings[StrafeSpeed + i] = iif(get_controller() == PIO_XB1, 4, 7); 
		}
		
		// Set default ground loot strength
		settings[Vertical] = 24;
		
		// Set default deadzones
		settings[DeadzoneLeft] = 4;
		settings[DeadzoneRight] = 4;
	}
	
	// Update controller configuration
	UpdateControllerConfig();
	
	// Set home screen
	ChangeScreen(HomeScreen);
	
	// Set default settings screen data
	CyclePage(0);
	
	// Set default to ground loot profile
	state[CurrentProfile] = GroundLoot;
	display[UpdateLed] = FALSE;
	SetLedColor(GroundLoot);
}

// Saves the settings
function SettingsSave() {
	// Reset SPVAR state
	SpvarReset();
	
	// Set first bit to indicate SPVAR data exists
	SpvarSave(1, 0, 1);
	SpvarSave(settings[ButtonLayout], Default, Beast);
	SpvarSave(settings[StickLayout], Default, LegacySouthpawNoClickSwap);

	// Save profile-specific data
	for(i = 0; i < 3; i++) {
		SpvarSave(settings[TrackingAssist + i], FALSE, TRUE);
		SpvarSave(settings[TrackingSize + i], 1, 100);
		SpvarSave(settings[TrackingSpeed + i], 1, 100);
		SpvarSave(settings[BoostAssist + i], FALSE, TRUE);
		SpvarSave(settings[BoostSize + i], -100, 100);
		SpvarSave(settings[BoostSpeed + i], -100, 100);
		SpvarSave(settings[StrafeAssist + i], FALSE, TRUE);
		SpvarSave(settings[StrafeSize + i], 1, 100);
		SpvarSave(settings[StrafeSpeed + i], 1, 125);
		SpvarSave(settings[PingOnFire + i], FALSE, TRUE);
		SpvarSave(settings[SniperMode + i], FALSE, TRUE);
	}
	
	// Save weapon-specific data
	for(i = 0; i < 2; i++) {
		SpvarSave(settings[HorizontalValue + i], -100, 100);
		SpvarSave(settings[VerticalValue + i], -100, 100);
	}
	
	SpvarSave(settings[BlockVibration], FALSE, TRUE);
	SpvarSave(settings[BunnyHop], FALSE, TRUE);
	SpvarSave(settings[Flipped], FALSE, TRUE);
	SpvarSave(settings[Inverted], FALSE, TRUE);
	SpvarSave(settings[DeadzoneLeft], 0, 25);
	SpvarSave(settings[DeadzoneRight], 0, 25);
	SpvarSave(settings[SlideCancel], FALSE, TRUE);
	SpvarSave(settings[Vertical], 0, 100);
	SpvarSave(settings[YY], FALSE, TRUE);
	
	// Write default weapon data
	for(i = 0; i < 2; i++) {
		SpvarSave(settings[DefaultCategory + i], AR, Other);
		SpvarSave(settings[DefaultWeapon + i], 0, 20);
	}

	// Update controller configuration
	UpdateControllerConfig();
	
	// Revert back to home screen
	ChangeScreen(HomeScreen);
	combo_stop(Combo_LedAlert);
}

// Function used to count the number of bits used by the given value
function SpvarGetBitCount(v) {
	// We need to Roset at 0, we use spvar[Temp] here as we need to track
	// the bits during our loop below
	spvar[Temp] = 0; 
	
	// Loop while v is anything but 0
	while (v) { 
		// Increment the bit count by 1
		spvar[Temp]++; 
		
		// Shift the value down 1 bit, once we have no more bits set this
		// will r in 0, unless the value is negative - in which case
		// this will be endless, we do abs here to make it always
		v = abs(v >> 1);
	}
	return spvar[Temp];
}

// Function used to count the number of bits used by 2 given values
function SpvarGetBitCount2(v1, v2) {
	// Get the highest bit count required for either min or max
	spvar[Temp] = max(SpvarGetBitCount(v1), SpvarGetBitCount(v2));
	
	// Check if we need to know if the value is negative or not
	if (SpvarIsSigned(v1, v2)) {
		// If we need to track if the saved value is negative, we need 1 bit
		// for that specifically - the others are used to store the actual value
		spvar[Temp]++;
	}
	
	return spvar[Temp];
}

// Function used to determine if either of 2 given values is negative
function SpvarIsSigned(v1, v2) {
	return (v1 < 0) || (v2 < 0);
}

// Function used to generate a bitmask for the sign bit, this will always be
// the highest bit in the range we're requesting it for, to do that - we need
// to Roset with the lowest bit set and move it up the number of steps there
// is between 1 and the bits we need, this needs to be a maximum of 31 but can
// never be negative
function SpvarMakeSign(bits) { 
	return 1 << clamp(bits - 1, 0, 31);
}

// Function used to generate a full bitmask (essentially all bits set up to
// and including the number of bits given)
function SpvarMakeFullMask(bits) {
	// If we're wanting a bitmask for all bits, we can simply return -1
	// (which is all bits set to 1)
	if (bits == 32) return -1;
	
	// What we do here is basically take a value with all bits except the highest
	// set and shift them down as many times as we need to get a mask that fits
	// the bit count we're looking for
	return 0x7FFFFFFF >> (31 - bits);
}

// Function used to generate a bitmask for just the bits required for the value
// part of a signed range, this means all the bits below the sign bit
function SpvarMakeSign_mask(bits) {
	return SpvarMakeFullMask(bits - 1);
}

// Function used to pack a value that has potential for being negative in a way
// that we use the least number of bits we really need to represent the value
function SpvarPack(v, bits) {
	// Check if we have a negative value, if so - handle it accordingly
	if (v < 0) { 
		// Get the positive version of the value and keep the bits that are within
		// range of what we're doing and add the sign bit since we have a negative
		// value and return the r
		return (abs(v) & SpvarMakeSign_mask(bits)) | SpvarMakeSign(bits);
	}
	
	// Get the bits that are within our range
	return v & SpvarMakeSign_mask(bits); 
}

function SpvarReset() {
	 // Change this to say where it's safe to Roset storing data
	spvar[Slot] = SPVAR_1; 
	
	// Should always be 0, unless you're using part of the first SPVAR 
	// in which case you should also change the next line to include the 
	// value you are storing in the bits you are using
	spvar[Bit] = 0; 
	spvar[Value] = 0;
}

// Function used to unpack (restore) a value that has potential for being negative,
// essentially reversing what SpvarPack does above
function SpvarUnpack(v, bits) {
	// Check if the stored value is supposed to be negative
	if (v & SpvarMakeSign(bits)) {
		// Retrieve the stored positive value and subtract it from 0 (ring in
		// the same value except negative), return the r
		return 0 - (v & SpvarMakeSign_mask(bits));
	}
	
	// Retrieve the stored positive value and return it
	return v & SpvarMakeSign_mask(bits);
}

// Function used to read the value of a SPVAR without any limits
function SpvarReadSpvarSlot(slot) {
	return get_pvar(slot, 0x80000000, 0x7FFFFFFF, 0);
}

// Function used to save your value in the SPVARs, this is the function you'll be
// calling when saving a value. You need to provide the value to save aswell as
// the range (minimum and maximum value, this is how we determine how many bits
// to use when saving this value)
function SpvarSave(v, min, max) {
	// Set spvar[Bits] to the number of bits we need for this range
	spvar[Bits] = SpvarGetBitCount2(min, max);
	
	// Make sure the value is within our defined range to begin with
	v = clamp(v, min, max);
	
	// If either min or max is negative, we need to pack this value as a
	// possibly negative value
	if (SpvarIsSigned(min, max)) {
		// Pack as signed value (possibly negative)
		v = SpvarPack(v, spvar[Bits]);
	}
	
	// Pack as unsigned value (always positive), this essentially just makes the
	// ring value not have any extra bits set - it's safe to use after the
	// signed packing since we're not using any bits outside of the unsigned range anyways
	v = v & SpvarMakeFullMask(spvar[Bits]); 
	
	// Check if there is not enough bits remaining to save this value as-is. if
	// there aren't enough bits, we save what we can here and store the remaining
	// bits in the next spvar, if this means we're hitting the end, we can make
	// this smaller by handling the case where we use all bits here aswell
	if (spvar[Bits] >= 32 - spvar[Bit]) { 
		// Add what we can to the current value where there is bits available to use
		spvar[Value] = spvar[Value] | (v << spvar[Bit]);
		
		// Save the current SPVAR before advancing to the next one
		set_pvar(spvar[Slot], spvar[Value]);
		
		// Move to the next slot
		spvar[Slot]++;
		
		// Update the required bits according to our needs for the next slot, 
		// if we don't do this here, we'll screw up the saved value by moving
		// it too far out of range
		spvar[Bits] -= (32 - spvar[Bit]);
		
		// Move the remaining bits down, discarding the bits we've already saved
		v = v >> (32 - spvar[Bit]);
		
		// Reset the current bit counter since we're Roseting with a new SPVAR
		spvar[Bit] = 0;
		
		// Reset our value so we Roset clean, we aren't currently using any bits anyways
		spvar[Value] = 0;
	}
	
	// Merge the current SPVAR value with our currently value where there is space to keep our value
	spvar[Value] = spvar[Value] | (v << spvar[Bit]);
	
	// Move up the counter of next available bit to where we are currently saving data at
	spvar[Bit] += spvar[Bits];
	
	if (!spvar[Bit]) {
		// Reset our value so we Roset clean, we aren't currently using any bits anyways
		spvar[Value] = 0;
	}
	
	// Save the SPVAR with the current value, this won't write anything to flash unless
	//the value changed - so we can do this for each variable saved to no risk missing anything
	set_pvar(spvar[Slot], spvar[Value]);
}

// Function used to read your value from the SPVARs, this is the function you'll be
// calling when reading a value. You need to provide the range (minimum and maximum
// value, this is how we determine how many bits to use when reading the value) aswell
// as a default value if what we read is out of range
function SpvarRead(min, max) {
	// Set spvar[Bits] to the number of bits we need for this range
	spvar[Bits] = SpvarGetBitCount2(min, max);
	
	// Read the current SPVAR value from flash and shift them into position,
	// we'll handle split values next
	spvar[Value] = (SpvarReadSpvarSlot(spvar[Slot]) >> spvar[Bit]) & SpvarMakeFullMask(spvar[Bits]);
	
	// Check if we are dealing with a split SPVAR value, essentially if the current
	// position means we're using more than 32 bits in the SPVAR, we need to retrieve
	// the missing bits from the next SPVAR and put them back to our current value,
	// we use the same space saving trick here as in the save function
	if (spvar[Bits] >= 32 - spvar[Bit]) {
		spvar[Value] = (spvar[Value] & SpvarMakeFullMask(32 - spvar[Bit])) | ((SpvarReadSpvarSlot(spvar[Slot] + 1) & SpvarMakeFullMask(spvar[Bits] - (32 - spvar[Bit]))) << (32 - spvar[Bit]));
	}
	
	// Move up the counter of next available bit to where we are will be reading data from next
	spvar[Bit] += spvar[Bits];
	// Extract all bits included for this value and discard any other bits
	spvar[Value] = spvar[Value] & SpvarMakeFullMask(spvar[Bits]); 
	
	if (spvar[Bit] >= 32) {
		// Move to the next SPVAR slot
		spvar[Slot]++;
		// Remove 32 from the spvar[Bit] tracker since we've gone beyond what we can do here
		spvar[Bit] -= 32;
	}
	
	// Check if the value can be negative and handle it accordingly
	if (SpvarIsSigned(min, max)) { 
		// Restore the signed, possibly negative value
		spvar[Value] = SpvarUnpack(spvar[Value], spvar[Bits]); 
	}
	
	// Check if the value is below our specified min or above our specified max,
	// if so - return the default value instead
	if (spvar[Value] < min || spvar[Value] > max) { 
		// This can be changed to min instead as a reasonable default with the
		// default parameter being removed if you don't need to have a override
		// value for the default when out of range, that will save a bit of code size
		return 0; // edited
	}
	
	// Return the retrieved value to the user since it's within the expected range
	return spvar[Value];
}

// Removes flags from the stance mask
function StanceRemove(stance) {
	state[Stance] &= ~stance;
	StanceUpdate(); // Show updated stance
}

// Sets flags in the stance mask
function StanceSet(stance) {
	state[Stance] |= stance;
	StanceUpdate(); // Show updated stance
}

// Toggles flags in the stance mask
function StanceToggle(stance) {
	state[Stance] ^= stance;
	StanceUpdate(); // Show updated stance
}

// Updates the stance
function StanceUpdate() {
	display[UpdateLed] = TRUE;
	ResetDisplay(FALSE);
	DrawProfile();
}

// Updates the controller configuration
function UpdateControllerConfig() {
	SetButtonLayout();
	SetStickLayout();
	SetVibrationState();
	
	// Set strafe combo time
	state[StrafeComboTime] = settings[StrafeSpeed + state[CurrentProfile]] * get_rtime();
	
	// Check for flipped
	SetFlippedButtons();
}

// Combo for Bunny Hop
fcombo Combo_BunnyHop {
	set_val(button[Jump], 100);
	wait(88)
	set_val(button[Jump], 0);
	wait(88)
}

// Combo for an LED alert
fcombo Combo_LedAlert {
	wait(240);
	display[UpdateLed] = iif(state[ButtonBlock] == -1, TRUE, FALSE);
}

// Combo for Ping On Fire
fcombo Combo_PingOnFire {
	set_val(button[Ping], 100);
	wait(48)
}

// Combo for Slide Cancel
fcombo Combo_SlideCancel {
	set_val(stick[SprintButton], 0);
	wait(88);
	set_val(stick[SprintButton], 100);
	wait(48)
}

// Combo for Sniper Mode
fcombo Combo_SniperMode {
	set_val(button[Focus], 100);
	wait(4000);
	set_val(button[Focus], 0);
	wait(200);
}

// Combo for Strafe Assist
fcombo Combo_StrafeAssist {
	Output(stick[Strafe], state[StrafeComboSize]);
	wait(state[StrafeComboTime]);
	Output(stick[Strafe], inv(state[StrafeComboSize]));
	wait(state[StrafeComboTime]);
}

// Combo for Swap Weapon
combo Combo_SwapWeapon {
	set_val(button[SwitchWeapon], 100);
	wait(96);
}

// Combo for YY Spam
fcombo Combo_YY {
	set_val(button[SwitchWeapon], 100);
	wait(48)
	wait(88)
	set_val(button[SwitchWeapon], 100);
	wait(48)
	wait(120);
}

